<%

var A = typeof act !== "undefined" && act && typeof act === "object" ? act : {};

var aSave = A.save ? String(A.save) : "حفظ التغييرات";
var aIcon = A.icon === undefined ? "save" : String(A.icon || "");
var aCancel = A.cancel ? String(A.cancel) : "";
var aNote = A.note ? String(A.note) : "";
var aAttrs = A.attrs ? String(A.attrs) : "";

var aBadge = A.badge === undefined || A.badge === null || A.badge === "" ? null : String(A.badge);

var PATHS = {
  save: "M17 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-4-4Zm-5 16a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm3-10H7V5h8v4Z",
  plus: "M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z"
};
-%>
<div class="form-actions">
  <button class="btn" type="submit"<%- aAttrs %>>
<% if (aIcon && PATHS[aIcon]) { -%>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="<%= PATHS[aIcon] %>" /></svg>
<% } -%>
    <%= aSave %>
<%
-%>
<% if (aBadge !== null) { -%>
    <span class="btn__badge num" dir="ltr" data-qcount><%= aBadge %></span>
<% } -%>
  </button>
<% if (aCancel) { -%>
  <a class="btn btn--ghost" href="<%= aCancel %>">إلغاء</a>
<% } -%>
<% if (aNote) { -%>
  <p class="field-hint"><%= aNote %></p>
<% } -%>
</div>
