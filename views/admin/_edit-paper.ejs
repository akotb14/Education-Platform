<%

var KIND = typeof kind !== "undefined" && kind ? String(kind) : "homework";
var paper = typeof data !== "undefined" && data && typeof data === "object" ? data : {};
var unitDocs = typeof units !== "undefined" && Array.isArray(units) ? units : [];
var curUnit = typeof currentUnit !== "undefined" && currentUnit ? String(currentUnit) : "";
var tok = typeof csrfToken !== "undefined" && csrfToken ? csrfToken : "";
var ok = typeof flashOk !== "undefined" && flashOk ? String(flashOk) : "";
var bad = typeof flashBad !== "undefined" && flashBad ? String(flashBad) : "";

var LABEL = { homework: "الواجب", quiz: "الكويز", exam: "الامتحان" }[KIND] || "الواجب";
var PLURAL = { homework: "الواجبات", quiz: "الكويزات", exam: "الامتحانات" }[KIND] || "الواجبات";
var LIST_HREF = "/admin/" + KIND;
var EDIT_HREF = { homework: "/editHomework", quiz: "/editQuiz", exam: "/editExam" }[KIND] || "/editHomework";

var QUESTIONS_HREF = {
  homework: "/questionsOfHomework",
  quiz: "/questionsOfQuiz",
  exam: "/questionsOfExam"
}[KIND] || "/questionsOfHomework";

var isExam = KIND === "exam";
var isHomework = KIND === "homework";

var prior = typeof formData !== "undefined" && formData && typeof formData === "object" ? formData : null;

function was(key, fallback) {
  if (prior && prior[key] !== undefined && prior[key] !== null && prior[key] !== "") {
    return String(prior[key]);
  }
  return fallback === undefined || fallback === null ? "" : String(fallback);
}

var existing = typeof question !== "undefined" && Array.isArray(question) ? question : [];

var curSubject = was("educetionlevel", paper.educetionlevel);
var curGrade = was("grade", paper.grade);

var PLACE_SUBJECTS = { biology: "الأحياء", geology: "الجيولوجيا" };
var PLACE_GRADES = { "1st": "الصف الأول", "2nd": "الصف الثاني", "3rd": "الصف الثالث" };

var placeGroups = [];
var placeSeen = {};
var linkField = KIND === "quiz" ? "quizId" : "homeId";

for (var d = 0; d < unitDocs.length; d++) {
  var doc = unitDocs[d] || {};
  var docRows = Array.isArray(doc.units) ? doc.units : [];
  for (var u = 0; u < docRows.length; u++) {
    var row = docRows[u] || {};
    var rowValue = String(doc._id) + ":" + String(row._id);
    var occupied = !!(row[linkField] && String(row[linkField]) !== String(paper._id));

    var head =
      (PLACE_SUBJECTS[doc.educetionlevel] || doc.educetionlevel || "—") +
      " · " +
      (PLACE_GRADES[doc.grade] || doc.grade || "—") +
      " · " +
      (row.month || "بدون شهر");

    if (!placeSeen[head]) {
      placeSeen[head] = { label: head, items: [] };
      placeGroups.push(placeSeen[head]);
    }
    placeSeen[head].items.push({
      value: rowValue,
      label: (row.unit || "بدون اسم") + (occupied ? " (مشغول)" : ""),
      disabled: occupied
    });
  }
}

var priorUnit = prior ? was("unitPlacement", curUnit) : curUnit;

var ICON = {
  info: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm2 16H8v-2h8v2Zm0-4H8v-2h8v2Zm-3-5V3.5L18.5 9H13Z",
  list: "M4 6h2v2H4V6Zm4 0h12v2H8V6ZM4 11h2v2H4v-2Zm4 0h12v2H8v-2ZM4 16h2v2H4v-2Zm4 0h12v2H8v-2Z"
};
%>

<%
%>
<% if (ok) { %>
<p class="flash flash--ok" role="status"><%= ok %></p>
<% } %>
<% if (bad) { %>
<p class="flash flash--bad" role="alert"><%= bad %></p>
<% } %>

<%
%>
<nav class="crumbs" aria-label="مسار التنقل">
  <a href="<%= LIST_HREF %>">كل <%= PLURAL %></a>
  <span aria-hidden="true">/</span>
  <span><%= paper.nameQuiz || LABEL %></span>
</nav>

<%
%>
<nav class="split-nav" aria-label="تعديل <%= LABEL %>">
  <span class="split-nav__item is-current" aria-current="page">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="<%= ICON.info %>" />
    </svg>
    بيانات <%= LABEL %>
  </span>
  <a class="split-nav__item" href="<%= QUESTIONS_HREF %>/<%= paper._id %>">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="<%= ICON.list %>" />
    </svg>
    إدارة الأسئلة
    <span class="split-nav__count num" dir="ltr"><%= existing.length %></span>
  </a>
</nav>

<section class="form-card">
  <h2 class="form-card__title">بيانات <%= LABEL %></h2>
  <p class="form-card__lede">
    عدّل بيانات <%= LABEL %> وإعداداته. الأسئلة تُدار من صفحة «إدارة الأسئلة»
    ولا يتأثر أي سؤال بالحفظ هنا.
  </p>

  <%
  %>
  <form method="post" action="<%= EDIT_HREF %>/<%= paper._id %>">
    <input type="hidden" name="_csrf" value="<%= tok %>" />

    <%
    %>
    <div class="form-grid">
      <%- include("_field", { fld: {
        type: "text", name: "nameQuiz", id: "nameQuiz",
        label: "اسم " + LABEL, value: was("nameQuiz", paper.nameQuiz),
        required: true, full: true, maxlength: 120, autocomplete: "off"
      } }) %>

      <%
      %>
      <%- include("_field", { fld: {
        type: "textarea", name: "description", id: "description",
        label: "وصف " + LABEL, value: was("description", paper.description),
        full: true, tall: true, rows: 4, maxlength: 500,
        hint: "اختياري — نبذة قصيرة عمّا يغطيه " + LABEL + " تظهر للمدرّس في لوحة التحكم."
      } }) %>

      <% if (isExam) { %>
      <%
      %>
      <%- include("_field", { fld: {
        type: "select", name: "educetionlevel", id: "educetionlevel",
        label: "المادة", list: "levels", value: curSubject, required: true
      } }) %>

      <%- include("_field", { fld: {
        type: "select", name: "grade", id: "grade", label: "الصف",
        list: "grades", value: curGrade, required: true
      } }) %>
      <% } %>

      <% if (!isExam) { %>
      <%
      %>
      <%- include("_field", { fld: {
        type: "select", name: "unitPlacement", id: "unitPlacement",
        label: "الدرس المرتبط", list: placeGroups, value: priorUnit,
        full: true, unknown: false, neutral: "بدون درس مرتبط",
        hint: "اختر درسًا لربط " + LABEL + " به. الدروس المشغولة بـ" + (KIND === "quiz" ? "كويز" : "واجب") + " آخر معطّلة."
      } }) %>
      <% } %>

      <% if (isExam) { %>
      <%
      %>
      <%- include("_field", { fld: {
        type: "datetime-local", name: "startTime", id: "startTime",
        label: "يفتح في", value: was("startTime", paper.startTime),
        required: true, width: "md"
      } }) %>

      <%- include("_field", { fld: {
        type: "datetime-local", name: "endTime", id: "endTime",
        label: "يغلق في", value: was("endTime", paper.endTime),
        required: true, width: "md"
      } }) %>
      <% } %>

      <% if (isHomework) { %>
      <%
      %>
      <%- include("_field", { fld: {
        type: "datetime-local", name: "dueDate", id: "dueDate",
        label: "موعد التسليم", value: was("dueDate", paper.dueDate),
        width: "md",
        hint: "اختياري. للعلم فقط — لا يُغلق " + LABEL + " تلقائيًا في هذا الموعد."
      } }) %>
      <% } %>

      <% if (!isHomework) { %>
      <%
      %>
      <%- include("_field", { fld: {
        type: "text", name: "quizTime", id: "quizTime", label: "مدة " + LABEL,
        value: was("quizTime", paper.quizTime), width: "sm", ltr: true,
        inputmode: "numeric", pattern: "[0-9]{1,2}:[0-9]{2}",
        placeholder: "00:30", autocomplete: "off",
        hintHtml: 'بصيغة ساعات:دقائق، مثل <span class="num" dir="ltr">00:30</span>. اتركه فارغًا لجعله بلا وقت.'
      } }) %>
      <% } %>
    </div>

    <%
    %>
    <%- include("_form-actions", { act: {
      cancel: LIST_HREF,
      note: "يحفظ بيانات " + LABEL + " فقط — الأسئلة لا تتغيّر."
    } }) %>
  </form>
</section>
