<%
/* =========================================================================
   EDIT ONE PAPER — shared by edithomework.ejs, editquiz.ejs and
   editexam.ejs, exactly as _assessment-form.ejs is shared by the three add
   pages. The three edit views were ~400 near-identical lines each and had
   already drifted: only editexam carried start/end time, only editquiz
   carried quizTime, and all three offered a subject select whose values
   ("Secondary" / "Preparatory") match nothing in the database.

   WHAT REPLACED WHAT
   The old page could add ONE question per submission, numbered from a
   30-item select the admin picked by hand, with the answer key typed as
   free text that had to match one of the four choices exactly. It now uses
   the same builder as the add form: many questions at once, position
   assigned by the server, answer key picked with a radio.

   The old form was also either/or — its handler updated the paper's
   details OR appended a question, never both, so editing the name and
   adding a question in one go silently dropped the question.

   WHICH FIELDS EACH KIND SHOWS
   Quiz and homework: the name and the lesson it is attached to. Nothing
   else, because nothing else on this form decided anything a student saw.
   The subject and grade selects are gone from BOTH: a paper's subject and
   grade are now read off the unit document the chosen lesson lives in, so
   the two can no longer disagree. Setting a paper to biology/3rd while its
   lesson sat under geology/1st used to be one careless save away, and the
   result was a paper that no list would show.

   Exam has no lesson to derive anything from, so it keeps the subject and
   grade selects, plus its start/end window and duration.

   LOCALS
     kind        "homework" | "quiz" | "exam"
     data        the paper
     question    its existing questions (array)
     units       unit documents, for the lesson picker. [] for exam
     currentUnit "docId:rowId" of the row pointing at this paper, or ""
     csrfToken   string
     flashOk / flashBad  strings, may be ""
     formData    a rejected submission to redisplay, or ""
   ====================================================================== */

var LABEL = { homework: "الواجب", quiz: "الكويز", exam: "الامتحان" }[kind];
var LIST_HREF = "/admin/" + kind;
var EDIT_HREF = { homework: "/editHomework", quiz: "/editQuiz", exam: "/editExam" }[kind];
var REMOVE_HREF = {
  homework: "/removeQuestionOfHomework",
  quiz: "/removeQuestionOfQuiz",
  exam: "/removeQuestionOfExam"
}[kind];

var isExam = kind === "exam";

/* A rejected submission comes back through flash. Every failure path
   redirects — correct, so a refresh cannot resubmit — but a redirect
   renders a blank form, and blanking twenty typed questions because one
   choice was left empty is not a usable way to work. Falls back to the
   stored paper when there is nothing to restore. */
var prior = typeof formData !== "undefined" && formData && typeof formData === "object" ? formData : null;
var priorQuestions = prior && Array.isArray(prior.questions) ? prior.questions : [];

function was(key, fallback) {
  if (prior && prior[key] !== undefined && prior[key] !== null && prior[key] !== "") {
    return String(prior[key]);
  }
  return fallback === undefined || fallback === null ? "" : String(fallback);
}

var existing = Array.isArray(question) ? question : [];

/* Only exam reads these. Quiz and homework take their subject and grade from
   the unit document the chosen lesson lives in — see editPaperPost. */
var curSubject = was("educetionlevel", data.educetionlevel);
var curGrade = was("grade", data.grade);
%>

<%
/* Class names are the ones _assessment-form.ejs already uses, because
   admin.css already styles those. This partial originally invented a
   parallel set — .notice, .card, .card__title, .empty, .btn--primary — none
   of which exist in the stylesheet, so the whole page rendered as unstyled
   flow content: full-bleed text, no card, no spacing, no responsive grid.
   .crumbs and .qlist* below are the only genuinely new components. */
%>
<% if (flashOk) { %>
<p class="flash flash--ok" role="status"><%= flashOk %></p>
<% } %>
<% if (flashBad) { %>
<p class="flash flash--bad" role="alert"><%= flashBad %></p>
<% } %>

<nav class="crumbs">
  <a href="<%= LIST_HREF %>">&#8592; كل <%= kind === "homework" ? "الواجبات" : kind === "quiz" ? "الكويزات" : "الامتحانات" %></a>
</nav>

<section class="form-card">
  <h2 class="form-card__title">بيانات <%= LABEL %></h2>
  <p class="form-card__lede">
    عدّل الاسم والدرس المرتبط، وأضف أسئلة جديدة إن أردت.
  </p>

  <form
    method="post"
    action="<%= EDIT_HREF %>/<%= data._id %>"
    enctype="multipart/form-data"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="form-grid">
    <div class="form-field">
      <label class="label" for="nameQuiz">اسم <%= LABEL %> <abbr title="مطلوب">*</abbr></label>
      <input
        class="input"
        type="text"
        id="nameQuiz"
        name="nameQuiz"
        required
        maxlength="120"
        autocomplete="off"
        value="<%= was("nameQuiz", data.nameQuiz) %>"
      />
    </div>

    <% if (isExam) { %>
    <%
    /* Exam only. An exam belongs to no lesson, so there is nothing to derive
       its subject and grade from and they have to be picked here.

       The values are biology / geology. The old select offered "Secondary"
       and "Preparatory" — which are grade stages, not subjects, and match no
       paper, no student and no query. Saving the form without touching this
       field rewrote the paper's subject to a value nothing looks for, and it
       vanished from the student lists. */
    %>
    <div class="form-field">
      <label class="label" for="educetionlevel">المادة <abbr title="مطلوب">*</abbr></label>
      <select class="select" id="educetionlevel" name="educetionlevel" required>
        <option value="biology"<%= curSubject === "biology" ? " selected" : "" %>>الأحياء</option>
        <option value="geology"<%= curSubject === "geology" ? " selected" : "" %>>الجيولوجيا</option>
      </select>
    </div>

    <div class="form-field">
      <label class="label" for="grade">الصف <abbr title="مطلوب">*</abbr></label>
      <select class="select" id="grade" name="grade" required>
        <option value="1st"<%= curGrade === "1st" ? " selected" : "" %>>الأول</option>
        <option value="2nd"<%= curGrade === "2nd" ? " selected" : "" %>>الثاني</option>
        <option value="3rd"<%= curGrade === "3rd" ? " selected" : "" %>>الثالث</option>
      </select>
    </div>
    <% } %>

    <% if (!isExam) { %>
    <%
    /* Lesson placement picker. Groups unit rows by subject/grade/month so a
       long list is navigable. Rows already pointing at a different paper are
       marked disabled. currentUnit is "docId:rowId" when this paper is already
       attached to a row, or "" when it's orphaned. */
    var SUBJECTS_MAP = { biology: "الأحياء", geology: "الجيولوجيا" };
    var GRADES_MAP = { "1st": "الأول", "2nd": "الثاني", "3rd": "الثالث" };

    var groups = [];
    var seen = {};
    var field = kind === "quiz" ? "quizId" : "homeId";

    for (var d = 0; d < units.length; d++) {
      var doc = units[d] || {};
      var rows = Array.isArray(doc.units) ? doc.units : [];
      for (var u = 0; u < rows.length; u++) {
        var row = rows[u] || {};
        var rowValue = String(doc._id) + ":" + String(row._id);
        var occupied = row[field] && String(row[field]) !== String(data._id);

        var head =
          (SUBJECTS_MAP[doc.educetionlevel] || doc.educetionlevel || "—") +
          " · " +
          (GRADES_MAP[doc.grade] || doc.grade || "—") +
          " · " +
          (row.month || "بدون شهر");

        if (!seen[head]) {
          seen[head] = { label: head, items: [] };
          groups.push(seen[head]);
        }
        seen[head].items.push({
          value: rowValue,
          label: row.unit || "بدون اسم",
          occupied: occupied
        });
      }
    }

    var priorUnit = prior ? was("unitPlacement", currentUnit) : currentUnit;
    %>
    <div class="form-field">
      <label class="label" for="unitPlacement">الدرس المرتبط</label>
      <select class="select" id="unitPlacement" name="unitPlacement">
        <option value="">— بدون —</option>
        <% for (var g = 0; g < groups.length; g++) { var group = groups[g]; %>
        <optgroup label="<%= group.label %>">
          <% for (var i = 0; i < group.items.length; i++) { var item = group.items[i]; %>
          <option
            value="<%= item.value %>"
            <%= priorUnit === item.value ? "selected" : "" %>
            <%= item.occupied ? "disabled" : "" %>
          >
            <%= item.label %><%= item.occupied ? " (مشغول)" : "" %>
          </option>
          <% } %>
        </optgroup>
        <% } %>
      </select>
      <p class="field-hint">
        اختر درسًا لربط <%= LABEL %> به. الدروس المشغولة بـ<%= kind === "quiz" ? "كويز" : "واجب" %> آخر معطّلة.
      </p>
    </div>
    <% } %>

    <% if (isExam) { %>
    <div class="form-field">
      <label class="label" for="startTime">يبدأ في</label>
      <input
        class="input"
        type="datetime-local"
        id="startTime"
        name="startTime"
        value="<%= was("startTime", data.startTime) %>"
      />
    </div>

    <div class="form-field">
      <label class="label" for="endTime">ينتهي في</label>
      <input
        class="input"
        type="datetime-local"
        id="endTime"
        name="endTime"
        value="<%= was("endTime", data.endTime) %>"
      />
    </div>

    <div class="form-field">
      <label class="label" for="quizTime">مدة <%= LABEL %></label>
      <input
        class="input"
        type="text"
        id="quizTime"
        name="quizTime"
        inputmode="numeric"
        pattern="[0-9]{1,2}:[0-9]{2}"
        placeholder="00:30"
        dir="ltr"
        value="<%= was("quizTime", data.quizTime) %>"
      />
      <%
      /* placeholder, not value. The old field shipped value="hh:mm" as its
         DEFAULT, so an untouched form stored the literal string "hh:mm",
         the duration parsed as NaN and the paper was silently untimed. */
      %>
      <p class="field-hint">بصيغة ساعات:دقائق — مثال <span class="num" dir="ltr">00:30</span>. اتركه فارغًا لجعله بلا وقت.</p>
    </div>
    <% } %>
  </div>

    <%
    /* Blocks shown on load: whatever a rejected submission left behind, or
       one empty block to start from. Existing questions are NOT loaded into
       the builder — they are listed below with their own delete buttons.
       Everything here is APPENDED on save. */
    var blocks = priorQuestions.length ? priorQuestions : [null];
    %>

    <div class="qbuilder" data-qbuilder data-max="50">
      <div class="qbuilder__head">
        <h3 class="qbuilder__title">إضافة أسئلة</h3>
        <p class="qbuilder__count">
          <%= LABEL %> يحتوي حاليًا على
          <span class="num" dir="ltr"><%= existing.length %></span>
          سؤالًا. ما تكتبه هنا يُضاف إليها، ويمكنك حفظ البيانات وحدها بترك
          الأسئلة فارغة.
        </p>
      </div>

      <% if (priorQuestions.length) { %>
      <p class="field-hint qbuilder__restored">
        صور الأسئلة لا يمكن استعادتها بعد رفض الإرسال — أعد اختيارها إن كنت أضفتها.
      </p>
      <% } %>

      <div class="qbuilder__list" data-qlist>
        <% for (var b = 0; b < blocks.length; b++) { %>
        <%- include("_question-block", { i: b, pos: b + 1, q: blocks[b] }) %>
        <% } %>
      </div>

      <div class="qbuilder__actions">
        <button class="btn btn--ghost qbuilder__add" type="button" data-qadd>
          إضافة سؤال آخر
        </button>
        <p class="field-hint qbuilder__limit">
          حتى <span class="num" dir="ltr">50</span> سؤالًا في المرة الواحدة.
        </p>
      </div>

      <p class="qbuilder__live sr-only" role="status" aria-live="polite" data-qlive></p>

      <%
      /* Inert until cloned: `required` does not validate inside a template
         and the fields do not post. admin.js rewrites the "__I__" index. */
      %>
      <template data-qtemplate>
        <%- include("_question-block", { i: "__I__", pos: "", q: null }) %>
      </template>
    </div>

    <div class="form-actions">
      <%
      /* The badge is what admin.js keeps in sync — it fills every
         [data-qcount] inside the form. The count belongs on the button
         because that is what the admin is about to press: "حفظ" with a 3 on
         it says three new questions are going along with the details. */
      %>
      <button class="btn" type="submit">
        حفظ
        <span class="btn__badge num" dir="ltr" data-qcount><%= blocks.length %></span>
      </button>
      <a class="btn btn--ghost" href="<%= LIST_HREF %>">رجوع</a>
    </div>
  </form>
</section>

<%
/* Existing questions live OUTSIDE the form above. Nesting them would put a
   <form> inside a <form> — the parser drops the inner one, and every delete
   button would submit the edit form instead of deleting its question. */
%>
<section class="panel qlist-panel">
  <div class="panel__head">
    <h2 class="panel__title">
      أسئلة <%= LABEL %> (<span class="num" dir="ltr"><%= existing.length %></span>)
    </h2>
  </div>

  <% if (!existing.length) { %>
  <div class="empty-state">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
      <rect x="9" y="3" width="6" height="4" rx="1" />
      <path d="M9 12h6M9 16h4" />
    </svg>
    <p class="empty-state__title">لا توجد أسئلة بعد</p>
    <p>أضف أول سؤال من النموذج بالأعلى.</p>
  </div>
  <% } else { %>
  <ol class="qlist">
    <% for (var k = 0; k < existing.length; k++) { var it = existing[k]; %>
      <%
      /* answer is [Array] in the schema — an array whose single element is
         the four choices. The old table printed answer[0][0..3] with no
         guard, so one legacy question saved in a different shape threw a
         TypeError and took the whole page down. */
      var choices = Array.isArray(it.answer) && Array.isArray(it.answer[0]) ? it.answer[0] : [];
      %>
    <li class="qlist__item">
      <div class="qlist__head">
        <span class="qlist__no num" dir="ltr"><%= k + 1 %></span>
        <p class="qlist__q"><%= it.question %></p>

        <%
        /* POST, not a GET link. As a GET, a link prefetch, a crawler or a
           mis-click deleted the question outright — no confirmation, no
           token. data-confirm is read by admin.js. */
        %>
        <form
          class="qlist__del"
          method="post"
          action="<%= REMOVE_HREF %>/<%= data._id %>/<%= it._id %>"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button
            class="btn btn--danger btn--sm"
            type="submit"
            data-confirm="حذف السؤال <%= k + 1 %>؟ لا يمكن التراجع."
          >
            حذف
          </button>
        </form>
      </div>

      <% if (it.image) { %>
      <p class="qlist__has-image">به صورة</p>
      <% } %>

      <ul class="qlist__choices">
        <% for (var c = 0; c < choices.length; c++) { %>
        <li class="<%= String(choices[c]) === String(it.correctAnswer) ? "is-correct" : "" %>">
          <span class="qlist__choice"><%= choices[c] %></span>
          <% if (String(choices[c]) === String(it.correctAnswer)) { %>
          <span class="qlist__flag">الإجابة الصحيحة</span>
          <% } %>
        </li>
        <% } %>
      </ul>
    </li>
    <% } %>
  </ol>
  <% } %>
</section>
