<%
var TYPE = typeof type !== "undefined" && type ? String(type) : "quiz";
var KINDS = {
  quiz: { label: "الكويزات", one: "الكويز", key: "deg-quiz" },
  homework: { label: "الواجبات", one: "الواجب", key: "deg-homework" },
  exam: { label: "الامتحانات", one: "الامتحان", key: "deg-exam" }
};
var K = KINDS[TYPE] || KINDS.quiz;
if (!KINDS[TYPE]) TYPE = "quiz";
%>
<%- include("_head", { active: K.key, title: "درجات " + K.label }) %>
<%

var attempts = typeof data !== "undefined" && Array.isArray(data) ? data : [];
var token = typeof csrfToken !== "undefined" && csrfToken ? csrfToken : "";

var FS =
  typeof f !== "undefined" && f && typeof f === "object"
    ? f
    : { group: "", grade: "", level: "", sort: "", q: "", active: false, touched: false };

var GRADE_MAP = typeof GRADE_LABEL !== "undefined" && GRADE_LABEL ? GRADE_LABEL : {};
var SUBJECT_MAP = typeof SUBJECT_LABEL !== "undefined" && SUBJECT_LABEL ? SUBJECT_LABEL : {};
var GROUP_MAP = typeof GROUP_LABEL !== "undefined" && GROUP_LABEL ? GROUP_LABEL : {};

var COUNT_GRADABLE =
  typeof autoGradableCount !== "undefined" && typeof autoGradableCount === "function"
    ? autoGradableCount
    : function (p) { return p && Array.isArray(p.quiz) ? p.quiz.length : 0; };

var ST =
  typeof GSTATUS !== "undefined" && GSTATUS
    ? GSTATUS
    : { NONE: "none", PENDING: "pending", PARTIAL: "partial", GRADED: "graded" };
var ST_LABEL =
  typeof GSTATUS_LABELS !== "undefined" && GSTATUS_LABELS
    ? GSTATUS_LABELS
    : { none: "لا يحتاج تصحيحًا", pending: "بانتظار التصحيح", partial: "تصحيح جزئي", graded: "تم التصحيح" };
var TOTALS =
  typeof totalsOf === "function"
    ? totalsOf
    : function () {
        return { manual: 0, manualOutOf: 0, final: null, finalOutOf: 0, pending: 0, status: "none" };
      };

var BADGE = {};
BADGE[ST.NONE] = "";
BADGE[ST.PENDING] = " badge--pending";
BADGE[ST.PARTIAL] = " badge--partial";
BADGE[ST.GRADED] = " badge--graded";

var rows = [];
var orphans = 0;
for (var a = 0; a < attempts.length; a++) {
  var it = attempts[a];
  if (!it) continue;
  if (!it.student) continue;
  if (!it.quiz) { orphans++; continue; }

  var totalQ = COUNT_GRADABLE(it.quiz);
  var t = TOTALS(it.quiz, it);
  var submitted = it.totalDegree != null && it.totalDegree !== "";
  var score = submitted ? Number(it.totalDegree) : null;
  if (score != null && !isFinite(score)) score = null;

  var pct = null;
  if (score != null && totalQ > 0) {
    pct = Math.round((score / totalQ) * 100);
  }

  rows.push({
    id: it._id,
    name: it.student.fullName || "—",
    card: it.student.cardNumber || "",
    group: it.student.group || "",
    sGrade: it.student.grade || "",
    sSubject: it.student.educetionlevel || "",
    paper: it.quiz.nameQuiz || "—",
    pGrade: it.quiz.grade || "",
    pSubject: it.quiz.educetionlevel || "",
    pType: it.quiz.type || TYPE,
    submitted: submitted,
    score: score,
    totalQ: totalQ,
    pct: pct,
    manual: t.manual,
    manualOutOf: t.manualOutOf,
    final: t.final,
    finalOutOf: t.finalOutOf,
    pending: t.pending,
    status: t.status
  });
}

var submittedRows = rows.filter(function (r) { return r.submitted; });
var scored = submittedRows.filter(function (r) { return r.pct != null; });
var avg = scored.length
  ? Math.round(scored.reduce(function (s, r) { return s + r.pct; }, 0) / scored.length)
  : null;

var filtering = !!FS.active;

var filterBits = [];
if (FS.group) filterBits.push("مجموعة " + (GROUP_MAP[FS.group] || FS.group));
if (FS.level) filterBits.push(SUBJECT_MAP[FS.level] || FS.level);
if (FS.grade) filterBits.push(GRADE_MAP[FS.grade] || FS.grade);
if (FS.q) filterBits.push("بحث: " + FS.q);
var filterText = filterBits.join(" — ");

var ICON = {
  chart: "M3 21V3h2v16h16v2H3Zm4-4V10h3v7H7Zm5 0V6h3v11h-3Zm5 0v-5h3v5h-3Z",
  search: "M10 2a8 8 0 1 0 4.9 14.3l5.4 5.4 1.4-1.4-5.4-5.4A8 8 0 0 0 10 2Zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12Z",
  trash: "M8 2h8v2h5v2H3V4h5V2Zm-3 6h14l-1 14H6L5 8Zm4 2v10h2V10H9Zm4 0v10h2V10h-2Z",
  users: "M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-8 1a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm0 2c-2.7 0-6 1.3-6 4v3h8v-3a5 5 0 0 1 1.5-3.4A10 10 0 0 0 8 14Zm8 0c-3 0-8 1.5-8 4.5V21h16v-2.5c0-3-5-4.5-8-4.5Z",
  check: "M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z",
  pen: "m3 17.2 9.9-9.9 3.8 3.8L6.8 21H3v-3.8ZM17.7 9.7 13.9 5.9l1.8-1.8a1 1 0 0 1 1.4 0l2.4 2.4a1 1 0 0 1 0 1.4l-1.8 1.8Z"
};
%>

<%
%>
<%- include("_table-toolbar", { action: "/showStudentsDegree/" + TYPE, search: true }) %>

<% if (rows.length) { %>
<ul class="stats stats--3">
  <li>
    <span class="stat">
      <span class="stat__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="<%= ICON.users %>" /></svg>
      </span>
      <span>
        <span class="stat__value num" dir="ltr"><%= rows.length %></span>
        <span class="stat__label">محاولة</span>
      </span>
    </span>
  </li>
  <li>
    <span class="stat stat--accent">
      <span class="stat__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="<%= ICON.check %>" /></svg>
      </span>
      <span>
        <span class="stat__value num" dir="ltr"><%= submittedRows.length %></span>
        <span class="stat__label">تم التسليم</span>
      </span>
    </span>
  </li>
  <li>
    <span class="stat">
      <span class="stat__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="<%= ICON.chart %>" /></svg>
      </span>
      <span>
        <%
        %>
        <span class="stat__value num" dir="ltr"><%= avg == null ? "—" : avg + "%" %></span>
        <span class="stat__label">متوسط النتيجة</span>
      </span>
    </span>
  </li>
</ul>
<% } %>

<section class="panel">
  <div class="panel__head">
    <h2 class="panel__title">درجات <%= K.label %></h2>
    <span class="pager__count">
      <% if (rows.length) { %>
      <span class="num" dir="ltr"><%= rows.length %></span> نتيجة
      <% if (filtering) { %>
      — <%= filterText %>
      <% } %>
      <% } else { %>
      لا نتائج
      <% } %>
    </span>
  </div>

  <% if (!rows.length) { %>
  <div class="empty-state">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="<%= ICON.chart %>" />
    </svg>
    <% if (filtering) { %>
    <p class="empty-state__title">لا نتائج تطابق هذه التصفية</p>
    <p>لم يدخل أي طالب مطابق لـ «<%= filterText %>»
      <%= K.label %> بعد.
      <a href="/showStudentsDegree/<%= TYPE %>">اعرض كل النتائج</a>.</p>
    <% } else { %>
    <p class="empty-state__title">لا توجد نتائج بعد</p>
    <p>ستظهر هنا درجات الطلاب فور دخولهم <%= K.label %>.</p>
    <% } %>
  </div>

  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption class="sr-only">
        درجات الطلاب في <%= K.label %>، مع إمكانية حذف أي نتيجة
      </caption>
      <thead>
        <tr>
          <th scope="col">الطالب</th>
          <th scope="col">رقم الكارت</th>
          <th scope="col">المجموعة</th>
          <th scope="col">صف الطالب</th>
          <th scope="col">اسم <%= K.one %></th>
          <th scope="col">صف <%= K.one %></th>
          <th scope="col">الدرجة</th>
          <th scope="col">حالة التصحيح</th>
          <th scope="col">إجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% for (var r = 0; r < rows.length; r++) { var row = rows[r]; %>
        <tr>
          <td class="table__name"><%= row.name %></td>

          <td>
            <% if (row.card) { %>
            <span class="table__code" dir="ltr"><%= row.card %></span>
            <% } else { %>—<% } %>
          </td>

          <td>
            <% if (row.group) { %>
            <span class="badge"><%= GROUP_MAP[row.group] || row.group %></span>
            <% } else { %>—<% } %>
          </td>

          <td>
            <%
            %>
            <% if (row.sGrade) { %>
            <span class="tag"><%= GRADE_MAP[row.sGrade] || row.sGrade %></span>
            <% } %>
            <% if (row.sSubject) { %>
            <span class="tag"><%= SUBJECT_MAP[row.sSubject] || row.sSubject %></span>
            <% } %>
            <% if (!row.sGrade && !row.sSubject) { %>—<% } %>
          </td>

          <td class="table__name"><%= row.paper %></td>

          <td>
            <% if (row.pGrade) { %>
            <span class="tag"><%= GRADE_MAP[row.pGrade] || row.pGrade %></span>
            <% } %>
            <% if (row.pSubject) { %>
            <span class="tag"><%= SUBJECT_MAP[row.pSubject] || row.pSubject %></span>
            <% } %>
            <% if (!row.pGrade && !row.pSubject) { %>—<% } %>
          </td>

          <td>
            <% if (!row.submitted) { %>
            <%
            %>
            <span class="badge">لم يُسلّم</span>
            <% } else { %>
            <%
            var hasManual = row.manualOutOf > 0;
            var shown = hasManual ? row.final : row.score;
            var shownOf = hasManual ? row.finalOutOf : row.totalQ;
            var shownPct =
              shown != null && shownOf > 0 ? Math.round((shown / shownOf) * 100) : null;
            var band = shownPct == null ? "" : shownPct >= 50 ? " score--pass" : " score--fail";
            %>
            <span class="score<%= band %>">
              <span class="num" dir="ltr"><%= shown == null ? row.score : shown %>/<%= shownOf %></span>
              <% if (shownPct != null) { %>
              <span class="score__pct num" dir="ltr"><%= shownPct %>%</span>
              <% } %>
            </span>
            <% if (row.pending) { %>
            <span class="badge badge--pending">
              <span class="num" dir="ltr"><%= row.pending %></span> سؤال بدون درجة
            </span>
            <% } %>
            <% } %>
          </td>

          <td>
            <%
            %>
            <% if (!row.submitted) { %>—<% } else { %>
            <span class="badge<%= BADGE[row.status] || "" %>">
              <%= ST_LABEL[row.status] || row.status %>
            </span>
            <% } %>
          </td>

          <td>
            <div class="row-actions">
              <%
              %>
              <% if (row.submitted) { %>
              <a class="btn btn--sm" href="/grading/<%= row.id %>">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="<%= row.status === ST.NONE ? ICON.check : ICON.pen %>" />
                </svg>
                <%= row.status === ST.NONE ? "عرض" : "تصحيح" %>
              </a>
              <% } %>

              <%
              %>
              <form
                method="post"
                action="/removestudentDegree/<%= encodeURIComponent(row.pType) %>/<%= row.id %>"
                data-confirm="حذف نتيجة «<%= row.name %>» في «<%= row.paper %>»؟ لا يمكن التراجع."
              >
                <% if (token) { %>
                <input type="hidden" name="_csrf" value="<%= token %>" />
                <% } %>
                <% if (FS.touched) { %>
                <%
                %>
                <input type="hidden" name="group" value="<%= FS.group %>" />
                <input type="hidden" name="educetionlevel" value="<%= FS.level %>" />
                <input type="hidden" name="grade" value="<%= FS.grade %>" />
                <input type="hidden" name="sort" value="<%= FS.sort %>" />
                <input type="hidden" name="q" value="<%= FS.q %>" />
                <% } %>
                <button class="btn btn--danger btn--sm" type="submit">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="<%= ICON.trash %>" />
                  </svg>
                  حذف
                </button>
              </form>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>

  <% if (orphans) { %>
  <p class="pager">
    <span class="pager__count">
      <span class="num" dir="ltr"><%= orphans %></span>
      نتيجة مخفية تخص <%= K.one %> تم حذفه.
    </span>
  </p>
  <% } %>
</section>

<%- include("_foot") %>
