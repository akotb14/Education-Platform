<%
/* =========================================================================
   ONE PAPER'S QUESTIONS — shared by questionsquiz.ejs, questionshomework.ejs
   and questionsexam.ejs, the way _edit-paper.ejs is shared by the three
   settings pages.

   THE OTHER HALF OF THE EDIT SPLIT. Everything on this page works on the
   question list; nothing on it can change the paper's name, its lesson, its
   window or its duration. Those live on the settings page, and the two are one
   click apart through the bar at the top.

   Why they are two pages at all: they used to be one form, so an admin fixing
   a typo in a quiz's name arrived at a page led by a question builder, and an
   admin adding a question had to re-submit the paper's settings to do it. The
   two jobs have nothing in common except the paper they belong to, and the
   combined form made the cheap job carry the expensive one's risk. See the
   block comment above editPaperGet in controllers/quiz.contro.js.

   FOUR OPERATIONS, four routes, all POST:
     add     /addQuestionsOf<Kind>/<paperId>        a batch, appended
     edit    /editQuestionOf<Kind>/<paperId>/<qId>  one question, in place
     move    /moveQuestionOf<Kind>/<paperId>/<qId>  swap with a neighbour
     delete  /removeQuestionOf<Kind>/<paperId>/<qId>

   Position is not cosmetic. A student's stored answers and a teacher's awarded
   marks are keyed by the question's POSITION in this list — degreeQuiz
   .answers[].index and .writtenAnswers[].index, and nothing anywhere stores a
   question _id. So moving or deleting a question moves every attempt's data
   with it; the controller's reindexAttempts is what keeps them together, and
   it is the reason reordering is a two-button swap rather than a drag-anywhere
   affordance. One swap is one two-entry permutation, which is auditable.

   ONE MODE AT A TIME, AND THAT IS DELIBERATE.
   admin.js does `document.querySelector("[data-qbuilder]")` — SINGULAR. Only
   the first builder on a page is wired: its type switcher, its option
   repeater, its add and remove buttons. Two builders on one page would leave
   the second one a dead form whose question-type select changed nothing.

   So this page renders exactly one of them:
     · no ?edit  — the ADD form, a full builder, plus the list below it;
     · ?edit=id  — the EDIT form for that one question, and no add form.
   The way back to adding is a link, not a second builder. Adding a question
   and rewriting an existing one are also different enough jobs that showing
   both at once would mostly invite saving the wrong one.

   LOCALS
     kind        "homework" | "quiz" | "exam"
     data        the paper
     question    its questions, in order (array). Read in full here — this is
                 the page that owns them
     editId      the question _id open for editing, or "" — already shape-
                 checked and resolved by the controller
     editIndex   its position, or -1 when nothing is open
     csrfToken   string
     flashOk / flashBad  strings, may be ""
     formData    a rejected submission to redisplay, or ""
     maxQuestions  how many questions one submission may carry

   Plus util/questionTypes.viewLocals() and util/grading.viewLocals(), which
   _question-block.ejs needs and which this page uses for typeOf / optionsOf.

   Every local is read behind a `typeof` guard. EJS compiles the body inside
   `with(locals)`, so a key the route did not pass is a ReferenceError, and a
   render error is thrown from inside res.render's callback — after the route's
   try/catch has already returned. Express then serves its own 500 and the
   admin loses the page with nothing to explain why. A guard turns that into an
   empty field.
   ====================================================================== */

var KIND = typeof kind !== "undefined" && kind ? String(kind) : "homework";
var paper = typeof data !== "undefined" && data && typeof data === "object" ? data : {};
var tok = typeof csrfToken !== "undefined" && csrfToken ? csrfToken : "";
var ok = typeof flashOk !== "undefined" && flashOk ? String(flashOk) : "";
var bad = typeof flashBad !== "undefined" && flashBad ? String(flashBad) : "";
var MAXQ = typeof maxQuestions !== "undefined" && Number(maxQuestions) > 0
  ? Number(maxQuestions)
  : 50;

var LABEL = { homework: "الواجب", quiz: "الكويز", exam: "الامتحان" }[KIND] || "الواجب";
var PLURAL = { homework: "الواجبات", quiz: "الكويزات", exam: "الامتحانات" }[KIND] || "الواجبات";
var LIST_HREF = "/admin/" + KIND;

/* The Kind segment in the route names is capitalised — /editQuestionOfQuiz,
   not /editQuestionOfquiz. Spelled out per kind rather than built by
   upper-casing a letter, so every URL this page emits can be grepped for. */
var R = {
  homework: {
    settings: "/editHomework",
    questions: "/questionsOfHomework",
    add: "/addQuestionsOfHomework",
    edit: "/editQuestionOfHomework",
    move: "/moveQuestionOfHomework",
    remove: "/removeQuestionOfHomework"
  },
  quiz: {
    settings: "/editQuiz",
    questions: "/questionsOfQuiz",
    add: "/addQuestionsOfQuiz",
    edit: "/editQuestionOfQuiz",
    move: "/moveQuestionOfQuiz",
    remove: "/removeQuestionOfQuiz"
  },
  exam: {
    settings: "/editExam",
    questions: "/questionsOfExam",
    add: "/addQuestionsOfExam",
    edit: "/editQuestionOfExam",
    move: "/moveQuestionOfExam",
    remove: "/removeQuestionOfExam"
  }
}[KIND] || {
  settings: "/editHomework",
  questions: "/questionsOfHomework",
  add: "/addQuestionsOfHomework",
  edit: "/editQuestionOfHomework",
  move: "/moveQuestionOfHomework",
  remove: "/removeQuestionOfHomework"
};

var PID = paper._id === undefined || paper._id === null ? "" : String(paper._id);
var SELF = R.questions + "/" + PID;

var existing = typeof question !== "undefined" && Array.isArray(question) ? question : [];

/* Which question is open, if any. The controller has already checked the shape
   of ?edit and resolved it to a position, so -1 here means "nothing open" and
   covers the stale-link case too: the question was deleted in another tab, and
   the honest answer is the list without it rather than an error. */
var openIdx = typeof editIndex !== "undefined" && Number.isInteger(Number(editIndex))
  ? Number(editIndex)
  : -1;
if (openIdx < 0 || openIdx >= existing.length) openIdx = -1;
var openId = typeof editId !== "undefined" && editId ? String(editId) : "";
if (!openId) openIdx = -1;
var isEditing = openIdx !== -1;

/* A rejected submission comes back through flash, because every failure path
   redirects — right, so a refresh cannot resubmit — and a redirect otherwise
   renders an empty form. `questions` is parseQuestions' echo: one entry per
   block that was submitted, in the shape _question-block.ejs reads. */
var prior = typeof formData !== "undefined" && formData && typeof formData === "object" ? formData : null;
var priorQuestions = prior && Array.isArray(prior.questions) ? prior.questions : [];

/* ---------------------------------------------------- the type vocabulary ---
   From util/questionTypes.viewLocals(). Guarded and given the same fallbacks
   _question-block.ejs uses, so this page still renders if a caller passes only
   some of them. */
var QT = typeof typeOf === "function" ? typeOf : function (q) {
  var t = q && q.qType;
  return t === "truefalse" || t === "explain" ? t : "mcq";
};
var OPTS = typeof optionsOf === "function" ? optionsOf : function (q) {
  var raw = q && Array.isArray(q.answer) ? q.answer[0] : null;
  if (!raw || typeof raw.length !== "number") return [];
  var out = [];
  for (var i = 0; i < raw.length; i++) {
    var v = raw[i] == null ? "" : String(raw[i]).trim();
    if (v) out.push(v);
  }
  return out;
};
var QLABELS = typeof QTYPE_LABELS !== "undefined" ? QTYPE_LABELS : {};
var TFOPTS = typeof TF_OPTIONS !== "undefined" ? TF_OPTIONS : ["صح", "خطأ"];

/* ------------------------------------------------- stored question -> block --
   _question-block.ejs is written against parseQuestions' ECHO shape —
   { type, question, answers, correct, tf, modelAnswer, maxScore } — where the
   answer key is an INDEX. A stored question is a different shape: the options
   live at answer[0] (see the [Array] comment in models/quiz.js) and
   correctAnswer holds the option's TEXT, because grading is a literal string
   compare by position.

   So an existing question has to be translated before it can be edited, and
   this is the only place that does it. Getting it wrong would not throw: the
   block would render with no radio checked, and saving it would rewrite the
   question with no answer key at all.

   answers is left EMPTY for truefalse and explain on purpose. The multiple-
   choice fieldset is rendered for every type (hidden and disabled for the two
   that do not use it), and prefilling it with a True/False question's own
   "صح"/"خطأ" would mean that an admin switching that question to multiple
   choice found those two words waiting as their options. Blank rows are the
   honest starting point. */
function asBlock(doc) {
  var t = QT(doc);
  var opts = OPTS(doc);
  var key = doc && doc.correctAnswer !== undefined && doc.correctAnswer !== null
    ? String(doc.correctAnswer)
    : "";

  var out = {
    type: t,
    question: doc && doc.question ? String(doc.question) : "",
    answers: t === "mcq" ? opts : [],
    correct: "",
    tf: "",
    modelAnswer: doc && doc.modelAnswer ? String(doc.modelAnswer) : "",
    maxScore: doc && doc.maxScore !== undefined && doc.maxScore !== null
      ? String(doc.maxScore)
      : ""
  };

  if (t === "truefalse") {
    /* TF_OPTIONS is the single definition of these two strings — the form and
       the grader both read it, so an index resolved through it cannot drift
       from what is stored. -1 (a paper whose stored text matches neither) comes
       back as "" and renders with neither radio checked, which is the truthful
       display of a question that has no usable key. */
    var n = TFOPTS.indexOf(key);
    out.tf = n === -1 ? "" : String(n);
  } else if (t === "mcq") {
    var c = opts.indexOf(key);
    out.correct = c === -1 ? "" : String(c);
  }

  return out;
}

/* What goes in the open block: what the admin just typed and had rejected, or
   the stored question. The echo wins — losing an edit to a validation error is
   the failure this whole flash round-trip exists to prevent. */
var openBlock = isEditing
  ? (priorQuestions.length ? priorQuestions[0] : asBlock(existing[openIdx]))
  : null;

/* On the ADD form, a rejected submission comes back as however many blocks
   were sent; a fresh page starts with one. */
var addBlocks = priorQuestions.length ? priorQuestions : [null];

var ICON = {
  plus: "M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z",
  info: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm2 16H8v-2h8v2Zm0-4H8v-2h8v2Zm-3-5V3.5L18.5 9H13Z",
  list: "M4 6h2v2H4V6Zm4 0h12v2H8V6ZM4 11h2v2H4v-2Zm4 0h12v2H8v-2ZM4 16h2v2H4v-2Zm4 0h12v2H8v-2Z",
  up: "M12 7.6l6 6L16.6 15 12 10.4 7.4 15 6 13.6l6-6Z",
  down: "M12 16.4l-6-6L7.4 9 12 13.6 16.6 9 18 10.4l-6 6Z",
  pencil: "M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25ZM20.7 7.04a1 1 0 0 0 0-1.41l-2.33-2.34a1 1 0 0 0-1.42 0l-1.83 1.84 3.75 3.75 1.83-1.84Z",
  trash: "M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z",
  clipboard: "M16 4h-1.2A2.8 2.8 0 0 0 12 2a2.8 2.8 0 0 0-2.8 2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm-4-.2a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8ZM8 6h8v14H8V6Z"
};
%>
<% if (ok) { %>
<p class="flash flash--ok" role="status"><%= ok %></p>
<% } %>
<% if (bad) { %>
<p class="flash flash--bad" role="alert"><%= bad %></p>
<% } %>

<nav class="crumbs" aria-label="مسار التنقل">
  <a href="<%= LIST_HREF %>">كل <%= PLURAL %></a>
  <span aria-hidden="true">/</span>
  <a href="<%= R.settings %>/<%= PID %>"><%= paper.nameQuiz || LABEL %></a>
  <span aria-hidden="true">/</span>
  <span>الأسئلة</span>
</nav>

<%
/* The same two-way bar the settings page carries, with the current side marked
   and not linked. It is above the form on both pages so that whichever job the
   admin came for, they can see the other one exists before they start typing. */
%>
<nav class="split-nav" aria-label="تعديل <%= LABEL %>">
  <a class="split-nav__item" href="<%= R.settings %>/<%= PID %>">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="<%= ICON.info %>" />
    </svg>
    بيانات <%= LABEL %>
  </a>
  <span class="split-nav__item is-current" aria-current="page">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="<%= ICON.list %>" />
    </svg>
    إدارة الأسئلة
    <span class="split-nav__count num" dir="ltr"><%= existing.length %></span>
  </span>
</nav>

<% if (isEditing) { %>
<%
/* ===================================================== EDIT ONE QUESTION ===
   Rendered INSTEAD of the add form, for the reason in the header comment: only
   the first [data-qbuilder] on the page gets wired, so there can be one.

   The block is rendered with i: 0, which is what makes parseQuestions find
   exactly one question in the body — it scans for names matching q_<n>_question
   and this form emits only q_0_*. The controller rejects a submission that
   parses to anything other than one question rather than silently saving the
   first, so a hand-built POST carrying q_0_ and q_1_ is an error, not a guess.

   data-max="1" is what keeps it to one: admin.js's renumber() runs on load and
   sets addBtn.disabled = cards >= max, so the add button below arrives disabled
   and its click handler returns early even if something re-enables it. The
   button exists at all only because the builder bails out entirely without one
   (`if (!list || !tpl || !addBtn) return;`) — and bailing out would cost this
   form its question-type switcher, which is the one thing an edit form cannot
   do without. It is `hidden` and `disabled` because it has no job here.

   The visible number in the block's legend reads 1 once JS has run — renumber()
   rewrites every [data-qno] to its position within THIS form, and there is one
   card in it. The question's real position is in the heading instead, where it
   is also correct with JS off. */
%>
<section class="form-card">
  <h2 class="form-card__title">
    تعديل السؤال
    <span class="num" dir="ltr"><%= openIdx + 1 %></span>
  </h2>
  <p class="form-card__lede">
    تعديل هذا السؤال فقط. باقي أسئلة <%= LABEL %> وترتيبها لا يتغيّر، ولا تتغيّر
    بيانات <%= LABEL %> نفسه.
  </p>

  <form
    method="post"
    action="<%= R.edit %>/<%= PID %>/<%= openId %>"
    enctype="multipart/form-data"
  >
    <input type="hidden" name="_csrf" value="<%= tok %>" />

    <div class="qbuilder" data-qbuilder data-max="1">
      <div class="qbuilder__list" data-qlist>
        <%- include("_question-block", { i: 0, pos: openIdx + 1, q: openBlock }) %>
      </div>

      <% if (priorQuestions.length) { %>
      <p class="field-hint qbuilder__restored">
        تمت استعادة ما كتبته. صورة السؤال لا يمكن استعادتها — أعد اختيارها إن
        كنت قد أرفقت صورة.
      </p>
      <% } %>

      <%
      /* Both required by admin.js and both inert. See the section comment. */
      %>
      <button class="qbuilder__add" type="button" data-qadd hidden disabled>
        <span class="sr-only">إضافة سؤال</span>
      </button>
      <template data-qtemplate></template>
    </div>

    <p class="qbuilder__live sr-only" role="status" aria-live="polite" data-qlive></p>

    <%
    /* No `badge`: the badge is the builder's question counter, and "1" on the
       save button of a form that edits one question says nothing. */
    %>
    <%- include("_form-actions", { act: {
      save: "حفظ السؤال", cancel: SELF,
      note: "إن رفعت صورة جديدة فستحل محل الصورة الحالية. اتركها فارغة للاحتفاظ بها."
    } }) %>
  </form>
</section>
<% } else { %>
<%
/* ========================================================= ADD A BATCH =====
   The same builder and the same _question-block the add-paper form uses, so a
   question typed here and a question typed there cannot end up validated
   differently — that divergence is what the combined edit form was written to
   fix in the first place, and splitting the pages must not bring it back.

   Appended, never replacing: the controller's only write is a $push, so no
   existing question changes position and no attempt needs remapping. It is the
   one of the four operations that does not touch reindexAttempts. */
%>
<section class="form-card">
  <h2 class="form-card__title">إضافة أسئلة إلى <%= LABEL %></h2>
  <p class="form-card__lede">
    تُضاف الأسئلة الجديدة في نهاية <%= LABEL %>. الأسئلة الموجودة وترتيبها
    وإجابات الطلاب عليها لا تتأثر.
  </p>

  <form
    method="post"
    action="<%= R.add %>/<%= PID %>"
    enctype="multipart/form-data"
  >
    <input type="hidden" name="_csrf" value="<%= tok %>" />

    <div class="qbuilder" data-qbuilder data-max="<%= MAXQ %>">
      <div class="qbuilder__head">
        <h3 class="qbuilder__title">أسئلة جديدة</h3>
        <p class="qbuilder__count">
          <span class="num" dir="ltr" data-qcount><%= addBlocks.length %></span>
          <span>سؤال</span>
        </p>
      </div>

      <% if (priorQuestions.length) { %>
      <p class="field-hint qbuilder__restored">
        تمت استعادة ما كتبته. صور الأسئلة لا يمكن استعادتها — أعد اختيارها إن
        كنت قد أرفقت صورًا.
      </p>
      <% } %>

      <div class="qbuilder__list" data-qlist>
        <% for (var b = 0; b < addBlocks.length; b++) { %>
        <%- include("_question-block", { i: b, pos: b + 1, q: addBlocks[b] }) %>
        <% } %>
      </div>

      <div class="qbuilder__actions">
        <button class="btn btn--ghost qbuilder__add" type="button" data-qadd>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="<%= ICON.plus %>" />
          </svg>
          إضافة سؤال آخر
        </button>
        <p class="field-hint qbuilder__limit">
          حتى <span class="num" dir="ltr"><%= MAXQ %></span> سؤالًا في المرة
          الواحدة. يمكنك الإضافة أكثر من مرة.
        </p>
      </div>

      <%
      /* The blueprint admin.js clones. Inside a template the markup is inert —
         the browser neither validates its `required` fields nor submits them —
         so it costs nothing until a question is actually added. "__I__" is
         replaced with the next free index on clone. */
      %>
      <template data-qtemplate>
        <%- include("_question-block", { i: "__I__", pos: "", q: null }) %>
      </template>
    </div>

    <p class="qbuilder__live sr-only" role="status" aria-live="polite" data-qlive></p>

    <%- include("_form-actions", { act: {
      save: "إضافة الأسئلة", icon: "plus", badge: addBlocks.length,
      cancel: R.settings + "/" + PID,
      note: "تُحفظ كل الأسئلة المكتوبة أعلاه دفعة واحدة."
    } }) %>
  </form>
</section>
<% } %>

<%
/* ==================================================== THE QUESTIONS, IN ORDER
   Read-only rows with their own action forms. OUTSIDE the form above, and it
   has to be: HTML has no nested forms, so a delete button placed inside the
   add form would be dropped by the parser and submit the batch instead.

   Cards, not a table. A table of number + question + up to six choices + four
   actions has no usable phone layout, and the previous stylesheet's answer to
   that was a 150%-wide table whose last column could not be reached at all.

   The order shown IS the order students see: the paper renders questions by
   array position, and `no` is only a stored label. Position is also what every
   attempt's stored answers and marks are keyed by. */
%>
<section class="panel qlist-panel">
  <div class="panel__head">
    <h2 class="panel__title">أسئلة <%= LABEL %></h2>
    <span class="pager__count">
      <span class="num" dir="ltr"><%= existing.length %></span>
    </span>
  </div>

  <% if (!existing.length) { %>
  <div class="empty-state">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="<%= ICON.clipboard %>" />
    </svg>
    <p class="empty-state__title">لا أسئلة بعد</p>
    <p>
      أضف أول سؤال من النموذج أعلاه.
      <%= LABEL %> بلا أسئلة لا يظهر للطلاب كورقة يمكن حلّها.
    </p>
  </div>
  <% } else { %>
  <ol class="qlist">
    <% existing.forEach(function (it, n) { %>
    <%
    var qKind = QT(it);
    var qOpts = OPTS(it);
    var qKey = it && it.correctAnswer !== undefined && it.correctAnswer !== null
      ? String(it.correctAnswer)
      : "";
    var qId = it && it._id !== undefined && it._id !== null ? String(it._id) : "";
    var isOpen = isEditing && qId === openId;
    %>
    <li class="qlist__item<%= isOpen ? " is-editing" : "" %>">
      <div class="qlist__head">
        <span class="qlist__no num" dir="ltr"><%= n + 1 %></span>
        <%
        /* A question with no text is a real state — an old row, or one saved
           before the text was required. Said out loud rather than left as an
           empty line, which would read as a rendering fault. */
        %>
        <p class="qlist__q"><%= it.question || "(بدون نص)" %></p>
        <span class="qlist__type"><%= QLABELS[qKind] || qKind %></span>
      </div>

      <% if (qKind === "explain") { %>
      <%
      /* No answer key to show: nothing here is machine-checkable. The model
         answer is what the marker reads, so that is what the row shows. */
      %>
      <% if (it.modelAnswer) { %>
      <p class="qlist__model">
        <span class="qlist__model-label">الإجابة النموذجية:</span>
        <%= it.modelAnswer %>
      </p>
      <% } else { %>
      <p class="qlist__model qlist__model--none">
        لا توجد إجابة نموذجية لهذا السؤال.
      </p>
      <% } %>
      <% } else if (qOpts.length) { %>
      <ul class="qlist__choices">
        <% qOpts.forEach(function (opt) { %>
        <%
        /* The key is stored as the option's TEXT, so the match is on text —
           the same comparison the grader makes. */
        %>
        <li class="<%= qKey !== "" && opt === qKey ? "is-correct" : "" %>">
          <span class="qlist__choice"><%= opt %></span>
          <% if (qKey !== "" && opt === qKey) { %>
          <span class="qlist__flag">صحيحة</span>
          <% } %>
        </li>
        <% }); %>
      </ul>
      <% } else { %>
      <p class="qlist__model qlist__model--none">
        لا اختيارات محفوظة لهذا السؤال. عدّله لإضافتها.
      </p>
      <% } %>

      <% if (it.image) { %>
      <p class="qlist__has-image">هذا السؤال يحتوي على صورة.</p>
      <% } %>

      <%
      /* THE ROW ACTIONS. Four separate forms and one link, side by side —
         siblings, never nested, for the same reason the whole section sits
         outside the add form.

         Up and down are POST, not GET links: they change stored data, and they
         move every attempt's answers with the question (reindexAttempts). A GET
         that reorders a paper is one a crawler or a link prefetch can trigger.
         Disabled at the ends as a courtesy — the controller also treats an
         out-of-range move as a silent no-op, because `disabled` is a browser
         convention and absent from a hand-built request.

         Delete carries data-confirm, which admin.js turns into a confirm()
         before submitting. Progressive enhancement: with JS off the form still
         submits, it just does not ask first. The protection that matters —
         POST, the CSRF token, the isAdmin guard — is all server-side. */
      %>
      <div class="qlist__actions">
        <form method="post" action="<%= R.move %>/<%= PID %>/<%= qId %>">
          <input type="hidden" name="_csrf" value="<%= tok %>" />
          <input type="hidden" name="dir" value="up" />
          <button
            class="qmove"
            type="submit"
            <%= n === 0 ? " disabled" : "" %>
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="<%= ICON.up %>" />
            </svg>
            <span class="sr-only">
              نقل السؤال <%= n + 1 %> إلى أعلى
            </span>
          </button>
        </form>

        <form method="post" action="<%= R.move %>/<%= PID %>/<%= qId %>">
          <input type="hidden" name="_csrf" value="<%= tok %>" />
          <input type="hidden" name="dir" value="down" />
          <button
            class="qmove"
            type="submit"
            <%= n === existing.length - 1 ? " disabled" : "" %>
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="<%= ICON.down %>" />
            </svg>
            <span class="sr-only">
              نقل السؤال <%= n + 1 %> إلى أسفل
            </span>
          </button>
        </form>

        <%
        /* Editing is a GET — a state of this page, carried in the query string,
           so the list stays on screen around the open block and the admin can
           see where the question they are changing sits. aria-current marks the
           one that is open. */
        %>
        <a
          class="btn btn--ghost btn--sm"
          href="<%= SELF %>?edit=<%= qId %>"
          <%= isOpen ? ' aria-current="true"' : "" %>
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="<%= ICON.pencil %>" />
          </svg>
          <%= isOpen ? "قيد التعديل" : "تعديل" %>
        </a>

        <form
          class="qlist__del"
          method="post"
          action="<%= R.remove %>/<%= PID %>/<%= qId %>"
          data-confirm="حذف السؤال <%= n + 1 %>؟ تُحذف معه إجابات الطلاب ودرجاتهم على هذا السؤال، ولا يمكن التراجع."
        >
          <input type="hidden" name="_csrf" value="<%= tok %>" />
          <button class="btn btn--danger btn--sm" type="submit">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="<%= ICON.trash %>" />
            </svg>
            حذف
          </button>
        </form>
      </div>
    </li>
    <% }); %>
  </ol>
  <% } %>
</section>
