<%- include("_head", { active: "students", title: "تعديل بيانات طالب" }) %>
<%

var st = typeof student !== "undefined" && student ? student : {};

var available =
  typeof month !== "undefined" && Array.isArray(month) ? month : [];

var chosen = [];
if (Array.isArray(st.month)) {
  for (var m = 0; m < st.month.length; m++) {
    var v = st.month[m];
    if (Array.isArray(v)) {
      for (var k = 0; k < v.length; k++) {
        if (v[k]) chosen.push(String(v[k]));
      }
    } else if (v) {
      chosen.push(String(v));
    }
  }
}
var isChosen = function (name) {
  return chosen.indexOf(String(name)) !== -1;
};

var token = typeof csrfToken !== "undefined" && csrfToken ? csrfToken : "";


var ROLES = [
  { value: "false", label: "طالب" },
  { value: "true", label: "مشرف" }
];

var curRole = st.admin === "true" ? "true" : "false";

var dupePhone =
  typeof checkPhone !== "undefined" && checkPhone ? checkPhone : null;
var phoneMsg = dupePhone ? "رقم الهاتف مُستخدَم بالفعل لحساب آخر." : "";
var phoneValue = dupePhone && dupePhone.phoneNumber
  ? dupePhone.phoneNumber
  : st.phoneNumber;
%>

<%
%>
<nav class="crumbs" aria-label="مسار التنقل">
  <a href="/student">الطلاب</a>
  <span aria-hidden="true">/</span>
  <span><%= st.fullName || "تعديل طالب" %></span>
</nav>

<section class="form-card">
  <h2 class="form-card__title">
    <%= st.fullName ? "تعديل بيانات " + st.fullName : "تعديل بيانات طالب" %>
  </h2>
  <p class="form-card__lede">
    الاسم الكامل مطلوب. باقي الحقول يمكن تركها فارغة وتعديلها لاحقًا.
  </p>

  <form method="post" action="/editStudent/<%= st._id %>">
    <input type="hidden" name="_csrf" value="<%= token %>" />

    <%
    %>
    <div class="form-grid">
      <%- include("_field", { fld: {
        type: "text", name: "fullName", id: "fullName", label: "الاسم الكامل",
        value: st.fullName, required: true, full: true, autocomplete: "name"
      } }) %>

      <%- include("_field", { fld: {
        type: "text", name: "cardNumber", id: "cardNumber", label: "رقم الكارت",
        value: st.cardNumber, width: "md", ltr: true, inputmode: "numeric",
        autocomplete: "off", hint: "رقم كارت الطالب. لا يمكن تكراره."
      } }) %>

      <%- include("_field", { fld: {
        type: "tel", name: "phoneNumber", id: "phoneNumber", label: "رقم الهاتف",
        value: phoneValue, width: "md", autocomplete: "tel",
        error: phoneMsg,
        hint: "هو ما يسجّل به الطالب دخوله. لا يمكن تكراره."
      } }) %>

      <%- include("_field", { fld: {
        type: "select", name: "educetionlevel", id: "educetionlevel",
        label: "المادة", list: "levels", value: st.educetionlevel
      } }) %>

      <%- include("_field", { fld: {
        type: "select", name: "grade", id: "grade",
        label: "الصف", list: "grades", value: st.grade
      } }) %>

      <%- include("_field", { fld: {
        type: "select", name: "group", id: "group",
        label: "المجموعة", list: "groups", value: st.group
      } }) %>

      <%- include("_field", { fld: {
        type: "select", name: "admin", id: "admin", label: "الصلاحية",
        neutral: false, list: ROLES, value: curRole,
        hint: "المشرف يرى لوحة التحكم بالكامل."
      } }) %>
    </div>

    <%
    %>
    <fieldset class="fieldset">
      <legend>الشهور المتاحة للطالب</legend>

      <% if (!available.length) { %>
      <p class="field-hint">
        لا توجد شهور مُضافة لهذا الصف والمادة بعد، فلا شيء يمكن تحديده هنا.
      </p>
      <% } else { %>
      <%
      %>
      <div class="check-grid">
        <% for (var i = 0; i < available.length; i++) { var mo = available[i];
           if (!mo || !mo.month) continue; %>
        <label class="check" for="month-<%= i %>">
          <input
            type="checkbox"
            id="month-<%= i %>"
            name="month"
            value="<%= mo.month %>"
            <%= isChosen(mo.month) ? " checked" : "" %>
          />
          <span><%= mo.month %></span>
        </label>
        <% } %>
      </div>

      <%
      %>
      <% } %>
    </fieldset>

    <%- include("_form-actions", { act: { cancel: "/student" } }) %>
  </form>
</section>

<%- include("_foot") %>
