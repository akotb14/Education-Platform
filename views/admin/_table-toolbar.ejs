<%

var TB_ACTION = typeof action !== "undefined" && action ? String(action) : "";

var TB_F =
  typeof f !== "undefined" && f && typeof f === "object"
    ? f
    : { group: "", grade: "", level: "", sort: "", q: "", active: false, touched: false };

var TB_GROUPS = typeof GROUPS !== "undefined" && Array.isArray(GROUPS) ? GROUPS : [];
var TB_GRADES = typeof GRADES !== "undefined" && Array.isArray(GRADES) ? GRADES : [];
var TB_SUBJECTS = typeof SUBJECTS !== "undefined" && Array.isArray(SUBJECTS) ? SUBJECTS : [];
var TB_SORTS = typeof SORTS !== "undefined" && Array.isArray(SORTS) ? SORTS : [];

var TB_SEARCH = typeof search !== "undefined" && search;
var TB_HIDDEN = typeof hidden !== "undefined" && hidden && typeof hidden === "object" ? hidden : null;
var TB_SELECTS = typeof selects !== "undefined" && Array.isArray(selects) ? selects : [];
var TB_EXTRA = typeof extra !== "undefined" && extra ? extra : "";

var TB_QS = typeof qs === "function" ? qs : null;

var TB_ICON = {
  search: "M10 2a8 8 0 1 0 4.9 14.3l5.4 5.4 1.4-1.4-5.4-5.4A8 8 0 0 0 10 2Zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12Z",
  excel: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm-1 7V3.5L18.5 9H13ZM8 12h1.8l1.2 2 1.2-2H14l-2 3.2 2 3.3h-1.8l-1.2-2.1-1.2 2.1H8l2-3.3L8 12Z"
};

function tbSelect(id, name, label, list, current, allLabel) {
%>
<div class="toolbar__field">
  <label class="label" for="<%= id %>"><%= label %></label>
  <select class="select" id="<%= id %>" name="<%= name %>">
    <% if (allLabel) { %>
    <option value=""<%= current ? "" : " selected" %>><%= allLabel %></option>
    <% } %>
    <% for (var i = 0; i < list.length; i++) { %>
    <option value="<%= list[i].value %>"<%= current === list[i].value ? " selected" : "" %>><%= list[i].label %></option>
    <% } %>
  </select>
</div>
<%
}
%>

<form class="toolbar" method="get" action="<%= TB_ACTION %>">
  <%
  if (TB_HIDDEN) {
    for (var hk in TB_HIDDEN) {
      if (!Object.prototype.hasOwnProperty.call(TB_HIDDEN, hk)) continue;
      if (TB_HIDDEN[hk] == null || TB_HIDDEN[hk] === "") continue;
  %>
  <input type="hidden" name="<%= hk %>" value="<%= TB_HIDDEN[hk] %>" />
  <% } } %>

  <% if (TB_SEARCH) { %>
  <div class="toolbar__field toolbar__field--wide">
    <label class="label" for="q">بحث</label>
    <input
      class="input"
      type="search"
      id="q"
      name="q"
      value="<%= TB_F.q || "" %>"
      placeholder="الاسم أو رقم الهاتف أو الكارت"
      autocomplete="off"
    />
  </div>
  <% } %>

  <% tbSelect("group", "group", "المجموعة", TB_GROUPS, TB_F.group, "كل المجموعات"); %>
  <% tbSelect("educetionlevel", "educetionlevel", "المادة", TB_SUBJECTS, TB_F.level, "كل المواد"); %>
  <% tbSelect("grade", "grade", "الصف", TB_GRADES, TB_F.grade, "كل الصفوف"); %>
  <%
  for (var s = 0; s < TB_SELECTS.length; s++) {
    var sel = TB_SELECTS[s] || {};
    tbSelect(
      sel.id || sel.name,
      sel.name,
      sel.label || "",
      Array.isArray(sel.list) ? sel.list : [],
      sel.current || "",
      sel.allLabel || null
    );
  }
  %>
  <% tbSelect("sort", "sort", "الترتيب", TB_SORTS, TB_F.sort, null); %>

  <div class="toolbar__actions">
    <button class="btn" type="submit">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="<%= TB_ICON.search %>" />
      </svg>
      عرض
    </button>

    <% if (TB_QS) { %>
    <%
    var TB_EXPORT_QS = {};
    if (TB_HIDDEN) {
      for (var ek in TB_HIDDEN) {
        if (!Object.prototype.hasOwnProperty.call(TB_HIDDEN, ek)) continue;
        TB_EXPORT_QS[ek] = TB_HIDDEN[ek];
      }
    }
    for (var xs = 0; xs < TB_SELECTS.length; xs++) {
      var xsel = TB_SELECTS[xs] || {};
      if (!xsel.name || !xsel.current) continue;
      TB_EXPORT_QS[xsel.name] = xsel.current;
    }
    TB_EXPORT_QS.export = "xlsx";
    %>
    <a
      class="btn btn--ghost"
      href="<%= TB_ACTION + TB_QS(TB_F, TB_EXPORT_QS) %>"
      download
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="<%= TB_ICON.excel %>" />
      </svg>
      تصدير Excel
    </a>
    <% } %>

    <% if (TB_F.touched) { %>
    <a class="btn btn--ghost" href="<%= TB_ACTION %>">إلغاء التصفية</a>
    <% } %>

    <%- TB_EXTRA %>
  </div>
</form>
