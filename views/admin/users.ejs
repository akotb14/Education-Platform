<%- include("_head", { active: "students", title: "الطلاب" }) %>
<%
/* =========================================================================
   STUDENT ROSTER

   WHAT THE OLD PAGE DID
     · Rendered EVERY matching student in one unpaginated table. The only
       filter was the group dropdown; with a real roster this is one <tr> per
       student on every load.
     · The filter <form> lived INSIDE .topbar, and its <select> was styled with
       `style="margin: 0 5px; width: 130px; height: 25px"` — a 25px control
       with no <label>, so screen readers announced an unnamed combobox.
     · Its placeholder <option> was `disabled selected hidden` with
       value="All", so after filtering by Monday the control snapped back to
       "Select Group" and gave no indication of the active filter.
     · Both row actions were GET links styled with inline `background-color`.
       `/removestudent/:id` DELETED A STUDENT ON GET — a crawler, a link
       prefetch, or a mis-click was enough, with no confirmation and no CSRF.
       Delete is a POST form now.
     · `<td style="display: flex">` — a flex table cell drops out of the table
       layout algorithm, so that column no longer aligned with its header.
     · Printed raw `undefined` in every empty cell, because interpolating
       `i.group` on a student with no group renders the string "undefined".
     · Built "Grade&Specialization" by string-concatenating
       `i.grade + " &"` — and `&` unescaped in text is an invalid entity start.
     · Title was "Uesrs" (sic), in English, on an Arabic platform.

   LOCALS  (all guarded)
     students  Array  the current page of students
     total     Number matching count across all pages
     page      Number 1-based
     pages     Number total page count
     group     String active group filter ("" or "All" = none)
     q         String active free-text search
     limit     Number rows per page

     Plus the shared filter locals from util/tableFilters.viewLocals():
     f, GROUPS, GRADES, SUBJECTS, SORTS, GROUP_LABEL, GRADE_LABEL,
     SUBJECT_LABEL, qs — spread in by the route and passed straight to
     _table-toolbar.ejs.
   ====================================================================== */

var rows =
  typeof students !== "undefined" && Array.isArray(students) ? students : [];
var totalRows =
  typeof total !== "undefined" && total != null ? Number(total) : rows.length;
var curPage = typeof page !== "undefined" && page ? Number(page) : 1;
var numPages = typeof pages !== "undefined" && pages ? Number(pages) : 1;
var perPage = typeof limit !== "undefined" && limit ? Number(limit) : 25;

if (!isFinite(curPage) || curPage < 1) curPage = 1;
if (!isFinite(numPages) || numPages < 1) numPages = 1;

/* The four filter values, from the route. Kept in one object so the pager and
   the empty state read the same state the toolbar renders. The fallback keeps
   this view renderable on its own — e.g. from an offline probe — and mirrors
   what tableFilters.parse({}) returns. */
var FS =
  typeof f !== "undefined" && f && typeof f === "object"
    ? f
    : { group: "", grade: "", level: "", sort: "", q: "", active: false, touched: false };

/* The label maps used to be redeclared here, in showStudDegree.ejs and in
   onlinestudent.ejs — three copies of the same eight weekday labels. They
   arrive as locals now; these aliases keep the table markup below unchanged.
   GRADES/SUBJECTS are the LABEL maps, not the {value,label} arrays the
   toolbar iterates — the arrays reach the partial under their own names. */
var GRADE_MAP = typeof GRADE_LABEL !== "undefined" && GRADE_LABEL ? GRADE_LABEL : {};
var SUBJECT_MAP = typeof SUBJECT_LABEL !== "undefined" && SUBJECT_LABEL ? SUBJECT_LABEL : {};
var GROUP_MAP = typeof GROUP_LABEL !== "undefined" && GROUP_LABEL ? GROUP_LABEL : {};

/* Page links must carry every filter AND the sort, or paging silently resets
   them. `qs` is tableFilters.toQuery, handed over as a local because EJS
   cannot require; it encodes each value, so a search term containing & cannot
   inject a parameter. */
var pageHref = function (p) {
  var build = typeof qs === "function" ? qs : null;
  return "/student" + (build ? build(FS, { page: p }) : "?page=" + p);
};

var firstRow = totalRows ? (curPage - 1) * perPage + 1 : 0;
var lastRow = Math.min(curPage * perPage, totalRows);

var ICON = {
  users:
    "M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-8 1a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm0 2c-2.7 0-6 1.3-6 4v3h8v-3a5 5 0 0 1 1.5-3.4A10 10 0 0 0 8 14Zm8 0c-3 0-8 1.5-8 4.5V21h16v-2.5c0-3-5-4.5-8-4.5Z",
  edit: "M4 17.2 16.4 4.8l2.8 2.8L6.8 20H4v-2.8Zm14.9-11-1.3-1.3 1.4-1.4 1.3 1.3-1.4 1.4Z",
  trash: "M8 2h8v2h5v2H3V4h5V2Zm-3 6h14l-1 14H6L5 8Zm4 2v10h2V10H9Zm4 0v10h2V10h-2Z",
  plus: "M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z"
};
%>

<%
/* One shared toolbar: search + group + subject + grade + name sort + Excel
   export. `extra` carries this page's own "إضافة طالب" action into the same
   button row, so it does not need a second flex container. */
%>
<%- include("_table-toolbar", {
  action: "/student",
  search: true,
  extra:
    '<a class="btn btn--ghost" href="/addStudent">' +
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">' +
    '<path d="' + ICON.plus + '" /></svg>إضافة طالب</a>'
}) %>

<section class="panel">
  <div class="panel__head">
    <h2 class="panel__title">قائمة الطلاب</h2>
    <span class="pager__count">
      <% if (totalRows) { %>
      عرض <span class="num" dir="ltr"><%= firstRow %>–<%= lastRow %></span>
      من <span class="num" dir="ltr"><%= totalRows %></span>
      <% } else { %>
      لا نتائج
      <% } %>
    </span>
  </div>

  <% if (!rows.length) { %>
  <div class="empty-state">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="<%= ICON.users %>" />
    </svg>
    <% if (FS.active) { %>
    <p class="empty-state__title">لا طالب يطابق هذه التصفية</p>
    <p>جرّب تصفية أخرى أو <a href="/student">أعد ضبط التصفية</a>.</p>
    <% } else { %>
    <p class="empty-state__title">لا يوجد طلاب مسجلون بعد</p>
    <p>أضف أول طالب من صفحة «إضافة طالب».</p>
    <% } %>
  </div>

  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption class="sr-only">قائمة الطلاب المسجلين، مع إمكانية التعديل والحذف</caption>
      <thead>
        <tr>
          <th scope="col">الاسم</th>
          <th scope="col">المجموعة</th>
          <th scope="col">الصف</th>
          <th scope="col">المادة</th>
          <th scope="col">رقم الهاتف</th>
          <th scope="col">رقم الكارت</th>
          <th scope="col">الصلاحية</th>
          <th scope="col">إجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% for (var r = 0; r < rows.length; r++) { var st = rows[r] || {}; %>
        <tr>
          <td class="table__name"><%= st.fullName || "—" %></td>

          <td>
            <% if (st.group) { %>
            <span class="badge"><%= GROUP_MAP[st.group] || st.group %></span>
            <% } else { %>—<% } %>
          </td>

          <td>
            <% if (st.grade) { %>
            <span class="tag"><%= GRADE_MAP[st.grade] || st.grade %></span>
            <% } else { %>—<% } %>
          </td>

          <td>
            <%= st.educetionlevel ? (SUBJECT_MAP[st.educetionlevel] || st.educetionlevel) : "—" %>
          </td>

          <td>
            <% if (st.phoneNumber) { %>
            <a class="table__tel" href="tel:<%= st.phoneNumber %>" dir="ltr"><%= st.phoneNumber %></a>
            <% } else { %>—<% } %>
          </td>

          <td>
            <% if (st.cardNumber) { %>
            <span class="table__code" dir="ltr"><%= st.cardNumber %></span>
            <% } else { %>—<% } %>
          </td>

          <td>
            <% if (st.admin === "true") { %>
            <span class="badge badge--admin">مشرف</span>
            <% } else { %>
            <span class="badge">طالب</span>
            <% } %>
          </td>

          <td>
            <div class="row-actions">
              <a class="btn btn--ghost btn--sm" href="/editStudent/<%= st._id %>">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="<%= ICON.edit %>" />
                </svg>
                تعديل
              </a>

              <%
              /* POST, not a GET link: a GET delete fires on prefetch, on a
                 crawler visit, and on any accidental navigation. The CSRF
                 token is what stops a third-party page submitting this form
                 with the admin's own cookie. data-confirm is read by
                 admin.js; if JS is unavailable the delete still works, it
                 just asks nothing first. */
              %>
              <form
                method="post"
                action="/removestudent/<%= st._id %>"
                data-confirm="هل تريد حذف «<%= st.fullName || "هذا الطالب" %>» نهائيًا؟"
              >
                <% if (typeof csrfToken !== "undefined" && csrfToken) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <% } %>
                <button class="btn btn--danger btn--sm" type="submit">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="<%= ICON.trash %>" />
                  </svg>
                  حذف
                </button>
              </form>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (numPages > 1) { %>
  <nav class="pager" aria-label="تصفّح الصفحات">
    <span class="pager__count">
      صفحة <span class="num" dir="ltr"><%= curPage %></span>
      من <span class="num" dir="ltr"><%= numPages %></span>
    </span>

    <div class="pager__nav">
      <%
      /* "Previous" points at a lower page number. In RTL the previous control
         belongs on the right, which is where the first flex item lands under
         dir="rtl" — no ordering override needed, and the arrow glyphs are
         chosen to match: previous points right, next points left. */
      %>
      <% if (curPage > 1) { %>
      <a class="btn btn--ghost btn--sm" href="<%= pageHref(curPage - 1) %>" rel="prev">
        <span aria-hidden="true">→</span> السابق
      </a>
      <% } else { %>
      <span class="btn btn--ghost btn--sm" aria-disabled="true">
        <span aria-hidden="true">→</span> السابق
      </span>
      <% } %>

      <% if (curPage < numPages) { %>
      <a class="btn btn--ghost btn--sm" href="<%= pageHref(curPage + 1) %>" rel="next">
        التالي <span aria-hidden="true">←</span>
      </a>
      <% } else { %>
      <span class="btn btn--ghost btn--sm" aria-disabled="true">
        التالي <span aria-hidden="true">←</span>
      </span>
      <% } %>
    </div>
  </nav>
  <% } %>
  <% } %>
</section>

<%- include("_foot") %>
