<%- include("_head", { active: "lessons", title: "الدروس" }) %>
<%

var docs = typeof lesson !== "undefined" && Array.isArray(lesson) ? lesson : [];
var tok = typeof csrfToken !== "undefined" && csrfToken ? csrfToken : "";
var ok = typeof flashOk !== "undefined" && flashOk ? String(flashOk) : "";
var bad = typeof flashBad !== "undefined" && flashBad ? String(flashBad) : "";

var SUBJECTS = { biology: "الأحياء", geology: "الجيولوجيا" };
var GRADES = {
  "1st": "الصف الأول",
  "2nd": "الصف الثاني",
  "3rd": "الصف الثالث"
};

var ORDINALS = [
  "الاول", "الثاني", "الثالث", "الرابع", "الخامس",
  "السادس", "السابع", "الثامن", "التاسع", "العاشر"
];
var MONTHS = [];
for (var m = 0; m < ORDINALS.length; m++) {
  MONTHS.push({ value: "الشهر " + ORDINALS[m], term: 1 });
}
for (var m2 = 0; m2 < ORDINALS.length; m2++) {
  MONTHS.push({ value: "الشهر " + ORDINALS[m2] + " الترم الثاني", term: 2 });
}

var MONTH_GROUPS = [
  { label: "الترم الأول", items: [] },
  { label: "الترم الثاني", items: [] }
];
for (var mg = 0; mg < MONTHS.length; mg++) {
  MONTH_GROUPS[MONTHS[mg].term === 2 ? 1 : 0].items.push({
    value: MONTHS[mg].value,
    label: MONTHS[mg].value
  });
}

var rows = [];
for (var d = 0; d < docs.length; d++) {
  var doc = docs[d] || {};
  var units = Array.isArray(doc.units) ? doc.units : [];
  for (var u = 0; u < units.length; u++) {
    var row = units[u] || {};
    rows.push({
      docId: doc._id,
      rowId: row._id,
      educetionlevel: doc.educetionlevel || "",
      grade: doc.grade || "",
      month: row.month || "",
      unit: row.unit || "",
      video: row.lesson || "",
      pdf: row.pdf || "",
      hasQuiz: !!row.quizId,
      hasHome: !!row.homeId
    });
  }
}

var monthIndex = {};
for (var mi = 0; mi < MONTHS.length; mi++) monthIndex[MONTHS[mi].value] = mi;
rows.sort(function (a, b) {
  if (a.educetionlevel !== b.educetionlevel)
    return a.educetionlevel < b.educetionlevel ? -1 : 1;
  if (a.grade !== b.grade) return a.grade < b.grade ? -1 : 1;
  var am = monthIndex[a.month] == null ? 99 : monthIndex[a.month];
  var bm = monthIndex[b.month] == null ? 99 : monthIndex[b.month];
  if (am !== bm) return am - bm;
  return String(a.unit).localeCompare(String(b.unit), "ar");
});

var ICON = {
  video:
    "M4 5h11a2 2 0 0 1 2 2v2.5l5-3v11l-5-3V17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z",
  trash: "M8 2h8v2h5v2H3V4h5V2Zm-3 6h14l-1 14H6L5 8Zm4 2v10h2V10H9Zm4 0v10h2V10h-2Z",
  ok: "M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z",
  bad: "M12 2 1 21h22L12 2Zm0 6 6.5 11h-13L12 8Zm-1 3v4h2v-4h-2Zm0 5v2h2v-2h-2Z",
  file: "M5 3h11l4 4v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm0 2v14h13V8h-4V5H5Z"
};
%>

<% if (ok) { %>
<p class="flash flash--ok" role="status">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="<%= ICON.ok %>" />
  </svg>
  <%= ok %>
</p>
<% } %>

<% if (bad) { %>
<p class="flash flash--bad" role="alert">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="<%= ICON.bad %>" />
  </svg>
  <%= bad %>
</p>
<% } %>

<section class="form-card">
  <h2 class="form-card__title">إضافة درس</h2>
  <p class="form-card__lede">
    الدرس هو أصغر وحدة محتوى. بعد إضافته يصبح متاحًا للربط بواجب أو كويز من
    صفحتَي «الواجبات» و«الكويزات».
  </p>

  <%
  %>
  <form method="post" action="/lesson" enctype="multipart/form-data">
    <% if (tok) { %>
    <input type="hidden" name="_csrf" value="<%= tok %>" />
    <% } %>

    <%
    %>
    <div class="form-grid">
      <%- include("_field", { fld: {
        type: "select", name: "educetionlevel", id: "educetionlevel",
        label: "المادة", list: "levels", required: true
      } }) %>

      <%- include("_field", { fld: {
        type: "select", name: "grade", id: "grade",
        label: "الصف", list: "grades", required: true
      } }) %>

      <%- include("_field", { fld: {
        type: "select", name: "month", id: "month", label: "الشهر",
        list: MONTH_GROUPS, required: true,
        hint: "أول درس في شهر جديد يفتح هذا الشهر تلقائيًا في صفحة الطالب."
      } }) %>

      <%- include("_field", { fld: {
        type: "text", name: "unit", id: "unit", label: "اسم الدرس",
        required: true, maxlength: 120, autocomplete: "off",
        placeholder: "مثال: الوحدة الأولى — الخلية",
        hint: "هذا الاسم هو ما يظهر للطالب وما يُربط به الواجب والكويز، فاجعله مميزًا داخل الشهر نفسه."
      } }) %>

      <%
      %>
      <%- include("_field", { fld: {
        type: "url", name: "lesson", id: "lessonLink", label: "رابط الفيديو",
        full: true, placeholder: "https://…", autocomplete: "off",
        hint: "رابط المشاهدة (Streamable أو YouTube)."
      } }) %>

      <%- include("_field", { fld: {
        type: "file", name: "pdf", id: "pdf", label: "ملف PDF", full: true,
        accept: ".pdf,application/pdf",
        hint: "اختياري. PDF فقط، بحد أقصى ١٠ ميجابايت."
      } }) %>
    </div>

    <%- include("_form-actions", { act: { save: "إضافة الدرس", icon: "plus" } }) %>
  </form>
</section>

<section class="panel">
  <div class="panel__head">
    <h2 class="panel__title">الدروس المضافة</h2>
    <span class="pager__count">
      <span class="num" dir="ltr"><%= rows.length %></span> درس
    </span>
  </div>

  <% if (!rows.length) { %>
  <div class="empty-state">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="<%= ICON.video %>" />
    </svg>
    <p class="empty-state__title">لا توجد دروس بعد</p>
    <p>أضف أول درس من النموذج أعلاه؛ الواجبات والكويزات تُربط بالدروس.</p>
  </div>

  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption class="sr-only">
        الدروس المضافة، مع المادة والصف والشهر وما هو مرتبط بكل درس
      </caption>
      <thead>
        <tr>
          <th scope="col">المادة</th>
          <th scope="col">الصف</th>
          <th scope="col">الشهر</th>
          <th scope="col">الدرس</th>
          <th scope="col">المحتوى</th>
          <th scope="col">مرتبط به</th>
          <th scope="col">إجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% for (var r = 0; r < rows.length; r++) { var it = rows[r]; %>
        <tr>
          <td><%= SUBJECTS[it.educetionlevel] || it.educetionlevel || "—" %></td>

          <td>
            <% if (it.grade) { %>
            <span class="tag"><%= GRADES[it.grade] || it.grade %></span>
            <% } else { %>—<% } %>
          </td>

          <td><%= it.month || "—" %></td>

          <td class="table__name"><%= it.unit || "—" %></td>

          <td>
            <div class="row-actions">
              <% if (it.video) { %>
              <%
              %>
              <a
                class="btn btn--ghost btn--sm"
                href="<%= it.video %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="<%= ICON.video %>" />
                </svg>
                فيديو
              </a>
              <% } %>

              <% if (it.pdf) { %>
              <a
                class="btn btn--ghost btn--sm"
                href="/<%= it.pdf %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="<%= ICON.file %>" />
                </svg>
                PDF
              </a>
              <% } %>

              <% if (!it.video && !it.pdf) { %>—<% } %>
            </div>
          </td>

          <td>
            <%
            %>
            <% if (it.hasQuiz) { %><span class="badge">كويز</span><% } %>
            <% if (it.hasHome) { %><span class="badge">واجب</span><% } %>
            <% if (!it.hasQuiz && !it.hasHome) { %>—<% } %>
          </td>

          <td>
            <%
            var warn = "هل تريد حذف درس «" + (it.unit || "بدون اسم") + "»؟";
            if (it.hasQuiz && it.hasHome) {
              warn += " سيُحذف معه الكويز والواجب المرتبطان به.";
            } else if (it.hasQuiz) {
              warn += " سيُحذف معه الكويز المرتبط به.";
            } else if (it.hasHome) {
              warn += " سيُحذف معه الواجب المرتبط به.";
            }
            %>
            <form
              method="post"
              action="/removelesson/<%= it.docId %>/<%= it.rowId %>"
              data-confirm="<%= warn %>"
            >
              <% if (tok) { %>
              <input type="hidden" name="_csrf" value="<%= tok %>" />
              <% } %>
              <button class="btn btn--danger btn--sm" type="submit">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="<%= ICON.trash %>" />
                </svg>
                حذف
              </button>
            </form>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<%- include("_foot") %>
