<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fe3f40" />

    <%
      /* =====================================================================
         SHARED QUESTION PAPER — replaces views/showQuestion.ejs, views/quiz/
         showQuestion.ejs and views/homework/showQuestion.ejs.

         Those three diverged only in which key held the questions
         (quiz.quiz / quiz.quizId.quiz / quiz.homeId.quiz) and whether a timer
         was drawn. Each caller now normalises to `paper` before rendering.
         The originals are left on disk, unreferenced.

         Rendered by:
           controllers/quiz.contro.js  GET /examApp/:nameQuiz      kind "exam"
           routes/quiz.router.js       GET /quizApp/:nameQuiz      kind "quiz"
           routes/homework.router.js   GET /homeworkApp/:nameQuiz  kind "homework"

         LOCALS
           kind          "quiz" | "exam" | "homework"
           paper         the quiz document (its `quiz` array holds the questions)
           secondsLeft   seconds remaining, or null on an untimed paper
           totalSeconds  the full allowance, for the progress bar
           alreadyTaken  truthy when this student has already submitted
           backHref      where the exit link goes

         THE POST CONTRACT IS UNCHANGED. Radios are still named answer0..answerN
         and still post to this same URL, because all three graders read
         req.body[`answer${i}`] against paper.quiz[i].correctAnswer by index.

         THE ASSESSMENT BAR. The countdown used to sit inside .paper, above the
         form — a sticky element nested in the question column, which read as
         part of the first question and left the paper with no header of its
         own. It is now a page-level bar carrying the paper's name, the
         student's position in the paper, the clock and the question pad, stuck
         to the top of the viewport for the whole sitting. Because it is
         `position: sticky` in normal flow it reserves its own space and cannot
         overlap a question — see the note on .abar in quiz.css. */

      var kindRaw = typeof kind !== "undefined" && kind ? String(kind) : "quiz";
      var KINDS = {
        quiz:     { a: "الكويز",   done: "تسليم الكويز" },
        exam:     { a: "الامتحان", done: "تسليم الامتحان" },
        homework: { a: "الواجب",   done: "تسليم الواجب" }
      };
      var K = KINDS[kindRaw] || KINDS.quiz;

      var doc = (typeof paper !== "undefined" && paper && typeof paper === "object") ? paper : null;
      var title = doc && doc.nameQuiz ? String(doc.nameQuiz) : "";

      /* Rows are read defensively. A question saved through the admin form
         with no options at all stores answer: [undefined], and the old
         showAnswer template did `for (j of data.quiz[i].answer[0])` straight
         onto that — "answer[0] is not iterable", thrown inside render. Express
         routes render errors to its own error handler rather than to the
         route's catch, so that surfaced as a 500 on the whole paper. */
      var rows = [];
      var all = doc && Array.isArray(doc.quiz) ? doc.quiz : [];

      /* The question-type whitelist. Guarded because EJS compiles with
         with(locals) — naming a local the route did not pass throws
         ReferenceError rather than yielding undefined — and inlined as a
         fallback so this page still renders if a route forgets to spread
         util/questionTypes.viewLocals(). */
      var QT = typeof QTYPES !== "undefined" ? QTYPES : ["mcq", "truefalse", "explain"];

      /* The two stored True/False options, same guard. Used only to decide
         WHICH icon goes on which choice; a paper whose two options are
         anything else still renders as a two-choice question, just without the
         tick and cross. */
      var TFO = typeof TF_OPTIONS !== "undefined" && TF_OPTIONS ? TF_OPTIONS : ["صح", "خطأ"];

      for (var i = 0; i < all.length; i++) {
        var q = all[i];
        if (!q) continue;

        var opts = [];
        var raw = q.answer && Array.isArray(q.answer) ? q.answer[0] : null;
        if (raw && typeof raw.length === "number") {
          for (var o = 0; o < raw.length; o++) {
            var v = raw[o] == null ? "" : String(raw[o]).trim();
            /* Empty strings are real in this data: the admin form posts a
               fixed number of option boxes and blanks are stored as "". */
            if (v) opts.push(v);
          }
        }

        /* Uploaded question images land in ./images/ (middlewares/upload.js),
           which app.js:73 mounts at the root, so the file is served at
           /<filename>.

           The old code was image.split('\\')[1] || image.split('/')[1] — the
           SECOND segment, not the last. It happened to work because multer
           stores exactly "images\name.png", but any deeper path returned
           undefined and rendered src="/". Splitting on both separators and
           taking the last segment is correct on Windows and POSIX alike. */
        var img = q.image ? String(q.image).trim() : "";
        var imgName = img ? img.split(/[\\/]/).pop() : "";

        rows.push({
          question: q.question == null ? "" : String(q.question),
          options: opts,
          /* Which input to render. Read through the same whitelist the server
             uses, because a question saved before question types existed has
             no qType field at all and must come out as multiple choice. */
          type: QT.indexOf(q.qType) !== -1 ? q.qType : "mcq",
          img: imgName ? "/" + encodeURIComponent(imgName) : ""
        });
      }

      var taken = typeof alreadyTaken !== "undefined" && !!alreadyTaken;
      var exitHref = typeof backHref !== "undefined" && backHref ? String(backHref) : "/";

      var left  = typeof secondsLeft  !== "undefined" && secondsLeft  != null ? Math.max(0, Math.floor(Number(secondsLeft)))  : null;
      var total = typeof totalSeconds !== "undefined" && totalSeconds != null ? Math.max(0, Math.floor(Number(totalSeconds))) : null;
      if (left !== null && isNaN(left)) left = null;
      if (total === null || isNaN(total) || total <= 0) total = left;
      var timed = left !== null && total !== null && total > 0;

      /* Is the student actually sitting the paper right now? Drives the
         assessment bar and the focused body class — the "already submitted"
         and "no questions" states are ordinary pages and keep the site header
         and the page hero. */
      var sitting = !taken && rows.length > 0;
    %>

    <meta name="robots" content="noindex, nofollow" />
    <title>
      <%= title ? title + " — " : "" %><%= K.a %> | منصة أ/ مرڤت عبدالرحمن
    </title>

    <link rel="icon" type="image/png" href="/assets/images/logo.png" />

    <script>
      document.documentElement.classList.add("js");
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/assets/css/tokens.css" />
    <link rel="stylesheet" href="/assets/css/home.css" />
    <link rel="stylesheet" href="/assets/css/listing.css" />
    <link rel="stylesheet" href="/assets/css/quiz.css" />

    <script src="/assets/js/home.js" defer></script>
    <script src="/assets/js/quiz.js" defer></script>
  </head>

  <!-- .paper-page only while a paper is actually being answered. It hands the
       top of the viewport to the assessment bar: the site header on this page
       is a logo and nothing else (see below), so keeping it stuck there would
       cost 72px of reading room for no navigation. -->
  <body<% if (sitting) { %> class="paper-page"<% } %> oncontextmenu="return false;">
    <a class="sr-only" href="#main">تخطي إلى المحتوى</a>

    <% if (sitting) { %>
    <!-- ===================================================== assessment bar ==
         The paper's own header: what is being sat, where the student is in it,
         how long is left, and a jump pad. Sticky for the whole sitting, so the
         clock is on screen at every scroll position — which is the one thing
         the old layout could not do, because the countdown lived inside the
         question column and scrolled away with the first question. -->
    <div class="abar" data-abar>
      <div class="abar__inner">
        <div class="abar__id">
          <span class="abar__kind"><%= K.a %></span>
          <p class="abar__title" title="<%= title || K.a %>">
            <%= title || K.a %>
          </p>
        </div>

        <p class="abar__pos">
          السؤال
          <strong class="num" data-qnow>1</strong>
          من
          <span class="num"><%= rows.length %></span>
        </p>

        <% if (timed) { %>
        <!-- data-seconds is this student's own remaining time, computed from a
             deadline stored on their degree record. It used to come from a
             module-level `let d` in the router — one variable shared by every
             student on the server, so two simultaneous attempts decremented
             the same counter.

             The deadline is also what the grader now checks the submission
             against (util/attemptTime.js), so clearing this countdown in the
             console no longer buys time: a late hand-in is recorded as late. -->
        <div
          class="abar__timer"
          data-timer
          data-seconds="<%= left %>"
          data-total="<%= total %>"
          role="timer"
          aria-live="off"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 10.6V6h-2v7.4l5.2 3.1 1-1.7-4.2-2.2Z" />
          </svg>
          <span class="sr-only">الوقت المتبقي</span>
          <!-- dir="ltr" plus tabular figures: a clock is a Latin digit run
               inside an RTL line, and the colons are bidi-neutral, so without
               isolation 01:20 can render as 20:01. -->
          <span class="abar__clock" data-clock dir="ltr">--:--</span>
        </div>

        <!-- Announced only when the remaining time crosses a threshold. The
             timer itself is aria-live="off" on purpose: a region that changes
             every second is read continuously and makes the page unusable with
             a screen reader. -->
        <span class="sr-only" data-timer-say role="status" aria-live="polite"></span>
        <% } %>
      </div>

      <% if (timed) { %>
      <!-- Time remaining, as a hairline across the foot of the bar. Animated as
           a percentage inline-size rather than scaleX: transform does not
           mirror under dir="rtl". -->
      <div class="abar__track" aria-hidden="true">
        <span class="abar__bar" data-bar></span>
      </div>
      <% } %>

      <% if (rows.length > 1) { %>
      <!-- ------------------------------------------------- question pad ----
           Which question is open, which have been answered, a way to reach any
           of them without scrolling the whole paper, and a step to the previous
           or next one. There was no question navigation on this page before —
           only the answered count in the foot.

           SECOND ROW OF THE BAR, under a hairline: identity, position and clock
           on the first line, navigation on the second.

           Buttons, not links: an anchor would put #q3 in the address bar and a
           reload of a paper mid-attempt is not something to encourage. Every
           button here is type="button" — inside a form, a button with no type is
           a submit button, so omitting it would turn "next question" into
           "hand in the paper".

           NONE of these move the bar. They scroll the page; the bar is sticky in
           CSS and no script touches its position. -->
      <nav class="qnav" aria-label="التنقل بين الأسئلة">
        <div class="qnav__inner">
          <p class="qnav__label" aria-hidden="true">الأسئلة</p>

          <!-- Previous. Disabled on the first question by quiz.js — a real
               disabled state, so it is announced and skipped by Tab rather than
               being a control that silently does nothing.

               The chevron points inline-end, because "back" under dir="rtl" is
               to the right. It is drawn with a logical path rather than a
               transform so it does not need mirroring. -->
          <button
            class="qnav__step"
            type="button"
            data-qprev
            aria-label="السؤال السابق"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M9.3 12l6-6L16.7 7.4 12.1 12l4.6 4.6L15.3 18l-6-6Z" />
            </svg>
          </button>

          <ul class="qnav__list">
            <% for (var n = 0; n < rows.length; n++) { %>
            <li>
              <button
                class="qnav__item"
                type="button"
                data-qjump="<%= n %>"
              >
                <span class="num"><%= n + 1 %></span>
                <!-- State in words as well as in fill and outline: colour is
                     never the only signal, and a pad of 20 chips is unreadable
                     to a screen reader without it. Written by quiz.js. -->
                <span class="sr-only" data-qjump-state></span>
              </button>
            </li>
            <% } %>
          </ul>

          <!-- Next. Disabled on the last question. -->
          <button
            class="qnav__step"
            type="button"
            data-qnext
            aria-label="السؤال التالي"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M14.7 12 8.7 18 7.3 16.6 11.9 12 7.3 7.4 8.7 6l6 6Z" />
            </svg>
          </button>
        </div>
      </nav>
      <% } %>
    </div>
    <% } %>

    <!-- AFTER the assessment bar, deliberately, and this is the only reason the
         bar can be at the top of the viewport at rest.

         .abar is `position: sticky`, which pins an element once the scroll
         reaches it and not before. While the site header sat above it in the
         document, "once the scroll reaches it" meant 73px down: at scrollY 0 the
         bar measured top=73, and only after scrolling past the header did it
         reach top=0. Making the header non-sticky (below) was not enough — a
         static box still occupies its space in flow. It had to move.

         So on a paper the assessment bar is the first thing in the body and the
         logo sits under it, which is also the order the brief's own layout
         asks for. When the page is not a sitting, the block above renders
         nothing and this is still the first element, unchanged.

         Nothing is removed: the logo is still a link home and still focusable,
         so no element leaves the tab order. It is now reached after the bar's
         own controls, which on a paper is the better order anyway — the clock
         and the jump pad are what a student Tabs for. -->
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-logo" href="/">
          <img
            src="/assets/images/logo.png"
            alt="منصة أ/ مرڤت عبدالرحمن"
            width="960"
            height="960"
          />
        </a>
        <!-- No nav on a paper in progress: every link here is a way to lose an
             attempt that cannot be retaken. The logo still goes home, and the
             exit link at the foot says plainly what leaving costs. -->
      </div>
    </header>

    <main id="main">
      <% if (!sitting) { %>
      <section class="page-hero">
        <div class="container page-hero__inner">
          <h1 class="page-hero__title">
            <% if (title) { %><em><%= title %></em><% } else { %>
            <em><%= K.a %></em><% } %>
          </h1>

          <div class="meta-row">
            <span class="chip chip--primary">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h10v2H4v-2Z" />
              </svg>
              <span class="num"><%= rows.length %></span> سؤال
            </span>
          </div>
        </div>
      </section>
      <% } %>

      <section class="section<%= sitting ? " section--paper" : "" %>">
        <div class="container">
          <% if (taken) { %>
          <!-- The old page rendered the bare English string "you can not enter
               exam again" as an unstyled <h2> on a blank document. -->
          <div class="empty">
            <span class="empty__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z" />
              </svg>
            </span>
            <h2 class="empty__title">لقد قمت بحل <%= K.a %> بالفعل</h2>
            <p class="empty__text">
              تم تسجيل إجاباتك، ولا يُسمح بأكثر من محاولة واحدة.
            </p>
            <div class="empty__actions">
              <a class="btn btn--primary" href="<%= exitHref %>" data-magnetic>
                العودة
              </a>
            </div>
          </div>

          <% } else if (!rows.length) { %>
          <div class="empty">
            <span class="empty__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-2h2v2Zm0-4h-2V7h2v6Z" />
              </svg>
            </span>
            <h2 class="empty__title">لا توجد أسئلة في <%= K.a %></h2>
            <p class="empty__text">
              لم تتم إضافة أي أسئلة بعد. تواصل مع السنتر إذا استمر ظهور هذه
              الرسالة.
            </p>
            <div class="empty__actions">
              <a class="btn btn--primary" href="<%= exitHref %>" data-magnetic>
                العودة
              </a>
            </div>
          </div>

          <% } else { %>
          <div class="paper">
            <!-- ONE form, opened once around the loop. The old markup opened a
                 <form> inside the per-question loop and closed it only inside
                 `if (i === last)`, leaving N-1 unclosed tags. It worked by
                 accident: the HTML parser drops a <form> start tag while a form
                 element pointer is already set, so every radio landed in the
                 first form. Posts to this same URL, as before. -->
            <form method="post" data-paper-form>
              <% for (var r = 0; r < rows.length; r++) { var row = rows[r];
                 var isTF = row.type === "truefalse" && row.options.length === 2; %>
              <article class="q" data-question id="q<%= r + 1 %>">
                <div class="q__head">
                  <span class="q__num" aria-hidden="true"><%= r + 1 %></span>
                  <div class="q__headings">
                    <h2 class="q__text">
                      <span class="sr-only">السؤال <%= r + 1 %>:</span>
                      <%= row.question %>
                    </h2>
                    <!-- What kind of answer is expected, said once, next to the
                         question. The type used to be visible only in the shape
                         of the controls below it. -->
                    <p class="q__kind">
                      <% if (row.type === "explain") { %>سؤال مقالي
                      <% } else if (isTF) { %>صح أو خطأ
                      <% } else { %>اختيار واحد<% } %>
                    </p>
                  </div>
                </div>

                <% if (row.img) { %>
                <figure class="q__figure">
                  <!-- alt="" is correct here: the image IS the question, and
                       the question text sits directly above it. The old markup
                       used alt="sa". -->
                  <img src="<%= row.img %>" alt="" loading="lazy" />
                </figure>
                <% } %>

                <% if (row.type === "explain") { %>
                <!-- A written answer. Posts under `explain<r>`, deliberately a
                     different name from the `answer<r>` radios: the grader
                     compares answer<r> to the stored key by position, and a
                     free-text field sharing that name could collide with it.
                     No `required` here either — same reason as the radios, the
                     timed auto-submit has to succeed with blanks. -->
                <div class="q__written">
                  <label class="sr-only" for="explain<%= r %>">
                    إجابتك على السؤال <%= r + 1 %>
                  </label>
                  <textarea
                    class="q__textarea"
                    id="explain<%= r %>"
                    name="explain<%= r %>"
                    rows="6"
                    maxlength="5000"
                    data-written
                    placeholder="اكتب إجابتك هنا…"
                  ></textarea>
                  <p class="q__note">تُصحَّح إجابة السؤال المقالي يدويًا.</p>
                </div>
                <% } else { %>
                <!-- A radiogroup rather than loose inputs, so the question text
                     is announced once with the options rather than per option.

                     True/False takes the same markup and the same POST field —
                     the two are byte-identical in the database, a two-option
                     multiple choice — and differs only in the modifier class,
                     which lays the two choices side by side and marks them with
                     a tick and a cross. -->
                <div
                  class="q__options<%= isTF ? " q__options--tf" : "" %>"
                  role="radiogroup"
                  aria-label="إجابات السؤال <%= r + 1 %>"
                >
                  <% if (!row.options.length) { %>
                  <p class="empty__text">لم يتم إضافة اختيارات لهذا السؤال.</p>
                  <% } %>
                  <% for (var p = 0; p < row.options.length; p++) {
                       /* MCQ choices are lettered so a student can say "I
                          picked B"; the letters are display only and nothing
                          about the posted value changes. */
                       var mark = isTF ? "" : String.fromCharCode(65 + p); %>
                  <!-- The whole row is the label, so the tap target is the full
                       card rather than the 20px radio. -->
                  <label class="opt<%= isTF ? " opt--tf" : "" %>">
                    <input
                      type="radio"
                      name="answer<%= r %>"
                      value="<%= row.options[p] %>"
                    />
                    <% if (isTF) { %>
                      <% if (row.options[p] === TFO[1]) { %>
                      <svg class="opt__glyph" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 5.7 18.3l-1.4-1.4L9.2 12 4.3 7.1l1.4-1.4L10.6 10.6l6.3-6.3 1.4 1.4Z" />
                      </svg>
                      <% } else { %>
                      <svg class="opt__glyph" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z" />
                      </svg>
                      <% } %>
                    <% } else { %>
                    <span class="opt__mark" aria-hidden="true"><%= mark %></span>
                    <% } %>
                    <span class="opt__text"><%= row.options[p] %></span>
                  </label>
                  <% } %>
                </div>
                <% } %>
              </article>
              <% } %>

              <div class="paper__foot">
                <div class="paper__tally">
                  <p class="paper__count">
                    تمت الإجابة على
                    <strong>
                      <span class="num" data-answered>0</span> من
                      <span class="num"><%= rows.length %></span>
                    </strong>
                  </p>
                  <!-- Answered progress, distinct from the time bar in the
                       assessment bar above: this one only ever grows. -->
                  <span class="paper__meter" aria-hidden="true">
                    <span class="paper__meter-fill" data-answered-bar></span>
                  </span>
                </div>

                <div class="paper__actions">
                  <button class="btn btn--primary" type="submit" data-magnetic>
                    <%= K.done %>
                  </button>
                  <a class="btn btn--ghost" href="<%= exitHref %>">
                    الخروج بدون تسليم
                  </a>
                </div>

                <!-- Shown after the student cancels the confirmation with
                     questions still blank, and cleared as soon as the last one
                     is filled in. Advisory: the inputs are never `required`,
                     because on a timed paper the automatic submit has to
                     succeed with blanks. -->
                <p class="paper__warn" data-warn hidden>
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2 1 21h22L12 2Zm1 15h-2v-2h2v2Zm0-4h-2V9h2v4Z" />
                  </svg>
                  <span>
                    لديك <span class="num" data-warn-count>0</span> سؤال بدون
                    إجابة، وهي مُعلَّمة بالأحمر في الصفحة.
                  </span>
                </p>
              </div>
            </form>
          </div>

          <!-- ================================================ confirm submit ==
               Outside the form on purpose: a button inside it would submit the
               paper on any stray Enter press, which is the opposite of a
               confirmation. quiz.js fills in the message and submits the form
               directly when the student agrees.

               The two wordings live here rather than in the script so the
               Arabic stays with the rest of the page's Arabic; {n} is the count
               quiz.js substitutes. With JavaScript off this never opens and the
               button submits straight away, which is the behaviour a paper with
               a deadline has to keep. -->
          <div
            class="cdlg"
            data-confirm
            data-msg-blanks="لديك {n} سؤال بدون إجابة. هل تريد تسليم <%= K.a %> الآن؟"
            data-msg-all="لقد أجبت على كل الأسئلة. هل تريد تسليم <%= K.a %> الآن؟"
            hidden
          >
            <div
              class="cdlg__panel"
              role="dialog"
              aria-modal="true"
              aria-labelledby="cdlg-title"
              aria-describedby="cdlg-text"
            >
              <h2 class="cdlg__title" id="cdlg-title">تأكيد التسليم</h2>
              <p class="cdlg__text" id="cdlg-text" data-confirm-text></p>
              <p class="cdlg__note">لا يمكن تعديل الإجابات بعد التسليم.</p>
              <div class="cdlg__actions">
                <button class="btn btn--primary" type="button" data-confirm-yes>
                  <%= K.done %>
                </button>
                <button class="btn btn--ghost" type="button" data-confirm-no>
                  الرجوع للمراجعة
                </button>
              </div>
            </div>
          </div>
          <% } %>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          © <span class="num">2026</span> جميع الحقوق محفوظة — منصة أ/ مرڤت
          عبدالرحمن.
        </p>
      </div>
    </footer>

    <script>
      document.onkeydown = function (e) {
        if (e.keyCode == 123) {
          return false;
        }
        if (e.ctrlKey && e.shiftKey && e.keyCode == "I".charCodeAt(0)) {
          return false;
        }
        if (e.ctrlKey && e.shiftKey && e.keyCode == "J".charCodeAt(0)) {
          return false;
        }
        if (e.ctrlKey && e.keyCode == "U".charCodeAt(0)) {
          return false;
        }
      };
    </script>
  </body>
</html>
