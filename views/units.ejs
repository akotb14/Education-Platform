<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fe3f40" />

    <%
      /* =====================================================================
         This view has TWO renderers and they pass different shapes:

           routes/units.router.js  /lessons/:educetionlevel/:grade/:month
               { data: [Unit docs], edu, grade, month, d, degreeHome }

           controllers/units.contro.js  getContent, mounted at
           /:edu/:grade/:month/:unit
               { data: <single unit sub-doc or "">, url }

         The second passes no edu/grade/month at all, so every local is read
         through a typeof guard. Under EJS's `with(locals)` an unguarded
         reference to a key that was never passed is a ReferenceError, which
         would turn that route into a 500 the moment it reached real markup.
         Guarded, it degrades to the empty state instead.

         `d` and `degreeHome` are passed by the lessons route and used by
         neither renderer — deliberately not referenced here. */
      var SUBJECTS = { biology: "الأحياء", geology: "الجيولوجيا" };
      var GRADES = {
        "1st": "الصف الأول الثانوي",
        "2nd": "الصف الثاني الثانوي",
        "3rd": "الصف الثالث الثانوي"
      };

      var eduRaw   = typeof edu   !== "undefined" && edu   ? String(edu)   : "";
      var gradeRaw = typeof grade !== "undefined" && grade ? String(grade) : "";

      /* isMonth gates this route on user.month.includes(req.params.month), so
         by the time we render, month is always a value an admin created — not
         free text from the address bar. Still escaped on output. */
      var monthName = typeof month !== "undefined" && month ? String(month) : "";

      var subjectName = SUBJECTS[eduRaw] || "";
      var gradeName = GRADES[gradeRaw] || "";

      /* Only built when both halves are in the whitelists, so the URL cannot
         be steered by a crafted param. Falls back to the homepage. */
      var monthsHref =
        SUBJECTS[eduRaw] && GRADES[gradeRaw] ? "/" + eduRaw + "/" + gradeRaw : "/";

      /* --------------------------------------------------------------------
         Flatten every Unit doc's `units` array down to the rows for THIS
         month. Same predicate the old template used
         (month == data[i]['units'][j].month), just hoisted out of the markup.

         Unit.addlesson keeps one Unit doc per (educetionlevel, grade) and
         $pushes every month's rows into its `units` array, so `data` is
         normally a single document and the outer loop runs once. It still
         iterates defensively — older data may have more than one. */
      var docs = (typeof data !== "undefined" && Array.isArray(data)) ? data : [];
      var units = [];
      for (var i = 0; i < docs.length; i++) {
        var doc = docs[i];
        var list = doc && Array.isArray(doc.units) ? doc.units : [];
        for (var j = 0; j < list.length; j++) {
          var u = list[j];
          if (!u) continue;
          if (String(u.month == null ? "" : u.month) !== monthName) continue;
          units.push({
            id: u._id,
            title: u.unit,
            /* Every segment of the link below comes from the stored document,
               not from req.params — so no request parameter ever reaches an
               href on this page. On the normal path they are equal anyway
               (the route queries Unit by exactly this edu/grade), but sourcing
               them from the record means a subject added later still links
               correctly even though SUBJECTS above does not know its name. */
            edu: doc.educetionlevel || eduRaw,
            grade: doc.grade || gradeRaw,
            month: u.month,
            /* `lesson` holds a Google Drive FILE ID, not prose — lesson.ejs
               embeds it as /file/d/<id>/preview. Presence means "has video". */
            hasVideo: !!(u.lesson && String(u.lesson).trim()),
            hasPdf: !!(u.pdf && String(u.pdf).trim()),
            hasQuiz: !!u.quizId
          });
        }
      }

      /* No ordering field exists on a unit row, so insertion order IS the
         teacher's own ordering — preserved, and numbered by position. (The
         months page sorts instead, because month names come from a fixed
         vocabulary; unit titles are free text and have no canonical order.) */
    %>

    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="دروس <%= monthName %> على منصة أ/ مرڤت عبدالرحمن."
    />

    <title>
      <%= monthName ? monthName + " — " : "" %>الدروس | منصة أ/ مرڤت عبدالرحمن
    </title>

    <link rel="icon" type="image/png" href="/assets/images/logo.png" />

    <!-- Set before the stylesheets so .reveal elements never flash visible.
         CSS keeps content visible unless this class is present, so a JS
         failure leaves a readable page rather than a blank one. -->
    <script>
      document.documentElement.classList.add("js");
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/assets/css/tokens.css" />
    <link rel="stylesheet" href="/assets/css/home.css" />
    <link rel="stylesheet" href="/assets/css/listing.css" />

    <script src="/assets/js/home.js" defer></script>
  </head>

  <body oncontextmenu="return false;">
    <a class="sr-only" href="#main">تخطي إلى المحتوى</a>

    <div class="scroll-progress" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-logo" href="/">
          <img
            src="/assets/images/logo.png"
            alt="منصة أ/ مرڤت عبدالرحمن"
            width="960"
            height="960"
          />
        </a>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span class="sr-only">القائمة</span>
          <span class="nav-toggle__bars" aria-hidden="true"></span>
        </button>

        <nav class="site-nav" id="site-nav" aria-label="التنقل الرئيسي">
          <ul class="site-nav__list">
            <li><a class="site-nav__link" href="/#courses">الصفوف</a></li>
            <li><a class="site-nav__link" href="/#activities">الاختبارات</a></li>
            <li><a class="site-nav__link" href="/#contact">تواصل</a></li>
            <li>
              <a
                class="site-nav__link site-nav__link--cta"
                href="/logout"
                data-magnetic
              >
                تسجيل الخروج
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- ======================================================= page hero -->
      <section class="page-hero">
        <div class="container page-hero__inner">
          <nav class="crumbs" aria-label="مسار التصفح">
            <ol class="crumbs__list">
              <li><a href="/">الرئيسية</a></li>
              <% if (subjectName) { %>
              <li class="crumbs__sep" aria-hidden="true">/</li>
              <li>
                <a href="<%= monthsHref %>">
                  <%= subjectName %><%= gradeName ? " — " + gradeName : "" %>
                </a>
              </li>
              <% } %> <% if (monthName) { %>
              <li class="crumbs__sep" aria-hidden="true">/</li>
              <li><span aria-current="page"><%= monthName %></span></li>
              <% } %>
            </ol>
          </nav>

          <!-- The page had no usable h1: the old heading was an h2 reading
               "المتاح" sitting above a level-1 heading that was always empty. -->
          <h1 class="page-hero__title">
            <% if (monthName) { %>دروس <em><%= monthName %></em><% } else { %>
            <em>الدروس</em><% } %>
          </h1>

          <p class="page-hero__lede">
            <% if (units.length) { %>
            اختر الدرس الذي تريد مشاهدته. كل درس يحتوي على الفيديو والملفات
            والاختبار الخاص به.
            <% } else { %>
            لم يتم رفع دروس هذا الشهر بعد.
            <% } %>
          </p>

          <div class="meta-row">
            <% if (gradeName) { %>
            <span class="chip">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3ZM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82Z" />
              </svg>
              <%= gradeName %>
            </span>
            <% } %> <% if (units.length) { %>
            <span class="chip chip--primary">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h10v2H4v-2Z" />
              </svg>
              <span class="num"><%= units.length %></span> درس
            </span>
            <% } %>
          </div>
        </div>
      </section>

      <!-- ========================================================== units -->
      <section class="section">
        <div class="container">
          <% if (!units.length) { %>
          <div class="empty">
            <span class="empty__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 4h6l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 6v8h16v-8H4Z" />
              </svg>
            </span>
            <h2 class="empty__title">لا توجد دروس في هذا الشهر بعد</h2>
            <p class="empty__text">
              يتم رفع الدروس أولًا بأول. تابع الصفحة أو تواصل مع السنتر لمعرفة
              موعد الرفع.
            </p>
            <div class="empty__actions">
              <a class="btn btn--primary" href="<%= monthsHref %>" data-magnetic>
                العودة لقائمة الشهور
              </a>
            </div>
          </div>

          <% } else { %>
          <div class="tile-grid">
            <% for (var k = 0; k < units.length; k++) { var t = units[k]; %>
            <div class="card-stage reveal">
              <a
                class="card tile"
                href="/content/<%= encodeURIComponent(t.edu) %>/<%= encodeURIComponent(t.grade) %>/<%= encodeURIComponent(t.month) %>/<%= encodeURIComponent(t.id) %>"
                data-tilt
              >
                <span class="tile__num" aria-hidden="true">
                  <span><%= k + 1 %></span>
                </span>
                <div class="card__body">
                  <h2 class="tile__title"><%= t.title %></h2>

                  <!-- Presence badges. A student could not tell what was in a
                       unit without opening it; every card looked identical. -->
                  <div class="tile__badges">
                    <% if (t.hasVideo) { %>
                    <span class="badge badge--video">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5v14l11-7L8 5Z" />
                      </svg>
                      فيديو
                    </span>
                    <% } %> <% if (t.hasPdf) { %>
                    <span class="badge">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M6 2h8l6 6v14H6V2Zm7 1.5V9h5.5L13 3.5ZM8 13h8v2H8v-2Zm0 4h8v2H8v-2Z" />
                      </svg>
                      ملف
                    </span>
                    <% } %> <% if (t.hasQuiz) { %>
                    <span class="badge badge--quiz">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-2h2v2Zm1.6-6.7-.9.9c-.5.5-.7 1-.7 1.8h-2v-.5c0-.8.3-1.5.9-2.1l1.2-1.2c.3-.4.4-.9.3-1.3a1.8 1.8 0 0 0-3.5.5h-2A3.8 3.8 0 0 1 12 4.5a3.8 3.8 0 0 1 3.8 3.8c0 .8-.3 1.5-.9 2Z" />
                      </svg>
                      اختبار
                    </span>
                    <% } %>
                  </div>

                  <span class="card__cta">
                    مشاهدة الدرس <span aria-hidden="true">←</span>
                  </span>
                </div>
              </a>
            </div>
            <% } %>
          </div>
          <% } %>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          © <span class="num">2026</span> جميع الحقوق محفوظة — منصة أ/ مرڤت
          عبدالرحمن.
          <br />Developed By:
          <a
            rel="nofollow noopener"
            href="https://www.facebook.com/profile.php?id=100011225383830"
            >Abdelrahman</a
          >
          &amp;
          <a rel="nofollow noopener" href="https://www.facebook.com/ahmed11mahomed"
            >Kotb</a
          >
        </p>
      </div>
    </footer>

    <button class="to-top" type="button" data-to-top>
      <span class="sr-only">العودة إلى أعلى الصفحة</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path
          d="M12 19V5m0 0-6 6m6-6 6 6"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <script>
      document.onkeydown = function (e) {
        if (e.keyCode == 123) {
          return false;
        }
        if (e.ctrlKey && e.shiftKey && e.keyCode == "I".charCodeAt(0)) {
          return false;
        }
        if (e.ctrlKey && e.shiftKey && e.keyCode == "J".charCodeAt(0)) {
          return false;
        }
        if (e.ctrlKey && e.keyCode == "U".charCodeAt(0)) {
          return false;
        }
      };
    </script>
  </body>
</html>
