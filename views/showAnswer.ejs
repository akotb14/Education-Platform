<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fe3f40" />

    <%

      var kindRaw = typeof kind !== "undefined" && kind ? String(kind) : "quiz";
      var KINDS = { quiz: "الكويز", exam: "الامتحان", homework: "الواجب" };
      var kindName = KINDS[kindRaw] || KINDS.quiz;

      var QT = typeof QTYPES !== "undefined" && QTYPES ? QTYPES : ["mcq", "truefalse", "explain"];

      var doc = (typeof data !== "undefined" && data && typeof data === "object") ? data : null;
      var title = doc && doc.nameQuiz ? String(doc.nameQuiz) : "";

      var att =
        typeof attempt !== "undefined" && attempt && typeof attempt === "object" ? attempt : null;
      var MARKS = {};
      if (doc && att && typeof reviewRows === "function") {
        var joined = reviewRows(doc, att) || [];
        for (var m = 0; m < joined.length; m++) {
          if (joined[m] && !joined[m].auto) MARKS[joined[m].index] = joined[m];
        }
      }

      var rows = [];
      var all = doc && Array.isArray(doc.quiz) ? doc.quiz : [];
      for (var i = 0; i < all.length; i++) {
        var q = all[i];
        if (!q) continue;

        var opts = [];
        var raw = q.answer && Array.isArray(q.answer) ? q.answer[0] : null;
        if (raw && typeof raw.length === "number") {
          for (var o = 0; o < raw.length; o++) {
            var v = raw[o] == null ? "" : String(raw[o]).trim();
            if (v) opts.push(v);
          }
        }

        var correct = q.correctAnswer == null ? "" : String(q.correctAnswer).trim();

        var img = q.image ? String(q.image).trim() : "";
        var imgName = img ? img.split(/[\\/]/).pop() : "";

        var qType = QT.indexOf(q.qType) !== -1 ? q.qType : "mcq";

        var mk = qType === "explain" ? MARKS[i] || null : null;

        rows.push({
          question: q.question == null ? "" : String(q.question),
          options: opts,
          correct: correct,
          type: qType,
          model: q.modelAnswer == null ? "" : String(q.modelAnswer).trim(),
          orphan: qType !== "explain" && correct !== "" && opts.indexOf(correct) === -1,
          img: imgName ? "/" + encodeURIComponent(imgName) : "",

          graded: !!(mk && mk.graded),
          score: mk && mk.graded ? mk.score : null,
          maxScore: mk ? mk.maxScore : null,
          feedback: mk && mk.feedback ? mk.feedback : "",
          written: mk && mk.text ? mk.text : ""
        });
      }

      var sc = typeof score !== "undefined" && score != null && String(score) !== "" ? Number(score) : null;
      if (sc !== null && isNaN(sc)) sc = null;

      var of_ = typeof outOf !== "undefined" && outOf != null ? Number(outOf) : NaN;
      if (isNaN(of_) || of_ < 0) of_ = rows.length;

      var T = doc && att && typeof totalsOf === "function" ? totalsOf(doc, att) : null;
      var hasManual = !!(T && T.manualOutOf > 0);
      var allMarked = !!(T && T.pending === 0 && T.final != null);
      var showFinal = hasManual && allMarked && T.finalOutOf > 0;

      var shown = showFinal ? T.final : sc;
      var shownOf = showFinal ? T.finalOutOf : of_;

      var low = shown !== null && shownOf > 0 && shown / shownOf < 0.5;

      var awaiting = typeof needsReview !== "undefined" && !!needsReview;

      var partly = !!(T && T.pending > 0 && T.pending < T.essays);

      var showScore = shown !== null && shownOf > 0;

      var exitHref = typeof backHref !== "undefined" && backHref ? String(backHref) : "/";

      var locked = typeof isLocked !== "undefined" && !!isLocked;
    %>

    <meta name="robots" content="noindex, nofollow" />
    <title>
      نموذج الإجابة<%= title ? " — " + title : "" %> | منصة أ/ مرڤت عبدالرحمن
    </title>

    <link rel="icon" type="image/png" href="/assets/images/logo.png" />

    <script>
      document.documentElement.classList.add("js");
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/assets/css/tokens.css" />
    <link rel="stylesheet" href="/assets/css/home.css" />
    <link rel="stylesheet" href="/assets/css/listing.css" />
    <link rel="stylesheet" href="/assets/css/quiz.css" />

    <script src="/assets/js/home.js" defer></script>
  </head>

  <body oncontextmenu="return false;">
    <a class="sr-only" href="#main">تخطي إلى المحتوى</a>

    <div class="scroll-progress" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-logo" href="/">
          <img
            src="/assets/images/logo.png"
            alt="منصة أ/ مرڤت عبدالرحمن"
            width="960"
            height="960"
          />
        </a>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span class="sr-only">القائمة</span>
          <span class="nav-toggle__bars" aria-hidden="true"></span>
        </button>

        <nav class="site-nav" id="site-nav" aria-label="التنقل الرئيسي">
          <ul class="site-nav__list">
            <li><a class="site-nav__link" href="/#courses">الصفوف</a></li>
            <li><a class="site-nav__link" href="/#activities">الاختبارات</a></li>
            <li><a class="site-nav__link" href="/#contact">تواصل</a></li>
            <li>
              <a
                class="site-nav__link site-nav__link--cta"
                href="/logout"
                data-magnetic
              >
                تسجيل الخروج
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="page-hero">
        <div class="container page-hero__inner">
          <nav class="crumbs" aria-label="مسار التصفح">
            <ol class="crumbs__list">
              <li><a href="/">الرئيسية</a></li>
              <li class="crumbs__sep" aria-hidden="true">/</li>
              <li><a href="<%= exitHref %>">العودة</a></li>
              <li class="crumbs__sep" aria-hidden="true">/</li>
              <li><span aria-current="page">نموذج الإجابة</span></li>
            </ol>
          </nav>

          <h1 class="page-hero__title"><em>نموذج الإجابة</em></h1>

          <% if (title) { %>
          <p class="page-hero__lede"><%= kindName %>: <%= title %></p>
          <% } %>

          <div class="meta-row">
            <span class="chip">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h10v2H4v-2Z" />
              </svg>
              <span class="num"><%= rows.length %></span> سؤال
            </span>

            <% if (showScore) { %>
            <span class="chip chip--primary">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2 9.2 8.6 2 9.2l5.5 4.8L5.8 21 12 17.3 18.2 21l-1.7-7 5.5-4.8-7.2-.6L12 2Z" />
              </svg>
              درجتك <span class="num" dir="ltr"><%= shown %></span> من
              <span class="num" dir="ltr"><%= shownOf %></span>
            </span>
            <% } %>

            <% if (showFinal) { %>
            <span class="chip chip--accent">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z" />
              </svg>
              تم تصحيح الأسئلة المقالية
            </span>
            <% } else if (awaiting) { %>
            <span class="chip">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 10.6V6h-2v7.4l5 3 1-1.7-4-2.1Z" />
              </svg>
              <% if (partly) { %>
              باقي <span class="num" dir="ltr"><%= T.pending %></span> سؤال مقالي
              بانتظار التصحيح
              <% } else { %>
              الأسئلة المقالية بانتظار التصحيح
              <% } %>
            </span>
            <% } %>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <% if (!rows.length) { %>
          <div class="empty">
            <span class="empty__icon" aria-hidden="true">
              <% if (locked) { %>
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1a5 5 0 0 0-5 5v3H5v13h14V9h-2V6a5 5 0 0 0-5-5Zm0 2a3 3 0 0 1 3 3v3H9V6a3 3 0 0 1 3-3Zm0 11a2 2 0 0 1 1 3.7V20h-2v-2.3A2 2 0 0 1 12 14Z" />
              </svg>
              <% } else { %>
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-2h2v2Zm0-4h-2V7h2v6Z" />
              </svg>
              <% } %>
            </span>
            <% if (locked) { %>
            <h2 class="empty__title">نموذج الإجابة غير متاح</h2>
            <p class="empty__text">
              يظهر نموذج الإجابة بعد أن تُسلّم محاولتك في <%= kindName %> ويتم
              تصحيحها.
            </p>
            <% } else { %>
            <h2 class="empty__title">لا يوجد نموذج إجابة</h2>
            <p class="empty__text">
              لم تتم إضافة أسئلة لهذا <%= kindName %>، أو تم حذفها.
            </p>
            <% } %>
            <div class="empty__actions">
              <a class="btn btn--primary" href="<%= exitHref %>" data-magnetic>
                العودة
              </a>
            </div>
          </div>

          <% } else { %>
          <div class="answer-key">
            <% if (showScore) { %>
            <div class="ak-score<%= low ? " ak-score--low" : "" %>">
              <span class="ak-score__value" dir="ltr"><%= shown %></span>
              <span class="ak-score__label">
                من <span class="num" dir="ltr"><%= shownOf %></span>
              </span>
              <% if (showFinal) { %>
              <%
              %>
              <span class="ak-score__split">
                <span class="num" dir="ltr"><%= T.auto %></span> تلقائي +
                <span class="num" dir="ltr"><%= T.manual %></span> يدوي
              </span>
              <% } %>
            </div>
            <% } %>

            <% if (awaiting) { %>
            <%
            %>
            <div class="notice ak-review">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 10.6V6h-2v7.4l5 3 1-1.7-4-2.1Z" />
              </svg>
              <p>
                <% if (partly) { %>
                تم تصحيح جزء من أسئلتك المقالية، وباقي
                <span class="num" dir="ltr"><%= T.pending %></span> سؤال بانتظار
                التصحيح اليدوي. الدرجة الظاهرة هنا لا تشمل الأسئلة التي لم تُصحَّح
                بعد.
                <% } else { %>
                إجاباتك المكتوبة على الأسئلة المقالية مسجّلة وبانتظار التصحيح
                اليدوي، ولا تدخل في الدرجة الظاهرة هنا.
                <% } %>
              </p>
            </div>
            <% } %>

            <% for (var r = 0; r < rows.length; r++) { var row = rows[r]; %>
            <div class="ak-q">
              <div class="q__head">
                <span class="q__num" aria-hidden="true"><%= r + 1 %></span>
                <h2 class="q__text">
                  <span class="sr-only">السؤال <%= r + 1 %>:</span>
                  <%= row.question %>
                </h2>
              </div>

              <% if (row.img) { %>
              <figure class="q__figure">
                <img src="<%= row.img %>" alt="" loading="lazy" />
              </figure>
              <% } %>

              <% if (row.type === "explain") { %>
              <%
              %>
              <% if (row.written) { %>
              <div class="ak-mine">
                <h3 class="ak-mine__title">إجابتك</h3>
                <p class="ak-mine__text"><%= row.written %></p>
              </div>
              <% } else if (row.graded || att) { %>
              <p class="ak-mine__none">لم تكتب إجابة لهذا السؤال.</p>
              <% } %>

              <% if (row.graded) { %>
              <%
              var pass = row.maxScore > 0 && row.score / row.maxScore >= 0.5;
              %>
              <div class="ak-mark<%= pass ? " ak-mark--pass" : " ak-mark--fail" %>">
                <span class="ak-mark__label">درجتك في هذا السؤال</span>
                <span class="ak-mark__value num" dir="ltr">
                  <%= row.score %>/<%= row.maxScore %>
                </span>
              </div>

              <% if (row.feedback) { %>
              <div class="ak-note">
                <h3 class="ak-note__title">ملاحظة المصحِّح</h3>
                <p class="ak-note__text"><%= row.feedback %></p>
              </div>
              <% } %>

              <% } else if (att) { %>
              <%
              %>
              <p class="ak-mark ak-mark--wait">
                <span class="ak-mark__label">بانتظار التصحيح اليدوي</span>
                <% if (row.maxScore) { %>
                <span class="ak-mark__value num" dir="ltr">
                  —/<%= row.maxScore %>
                </span>
                <% } %>
              </p>
              <% } %>

              <% if (row.model) { %>
              <div class="ak-model">
                <h3 class="ak-model__title">الإجابة النموذجية</h3>
                <p class="ak-model__text"><%= row.model %></p>
              </div>
              <% } else { %>
              <p class="ak-model__none">سؤال مقالي — يُصحَّح يدويًا.</p>
              <% } %>

              <% } else { %>
              <% if (!row.options.length) { %>
              <p class="empty__text">لم يتم إضافة اختيارات لهذا السؤال.</p>
              <% } %>

              <ul class="ak-opts">
                <% for (var p = 0; p < row.options.length; p++) { %>
                <% var isRight = row.correct !== "" && row.options[p] === row.correct; %>
                <li class="ak-opt<%= isRight ? " ak-opt--correct" : "" %>">
                  <span class="ak-opt__mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z" />
                    </svg>
                  </span>
                  <span class="opt__text"><%= row.options[p] %></span>
                  <% if (isRight) { %>
                  <span class="ak-opt__tag">الإجابة الصحيحة</span>
                  <% } %>
                </li>
                <% } %>
              </ul>

              <% if (row.orphan) { %>
              <p class="notice notice--warn">
                الإجابة الصحيحة المسجلة لهذا السؤال هي
                <strong><%= row.correct %></strong> وهي غير موجودة بين
                الاختيارات. راجع السنتر.
              </p>
              <% } %>
              <% } %>
            </div>
            <% } %>

            <div class="lesson-back">
              <a class="btn btn--primary" href="<%= exitHref %>" data-magnetic>
                <span aria-hidden="true">←</span> العودة
              </a>
            </div>
          </div>
          <% } %>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          © <span class="num">2026</span> جميع الحقوق محفوظة — منصة أ/ مرڤت
          عبدالرحمن.
        </p>
      </div>
    </footer>

    <button class="to-top" type="button" data-to-top>
      <span class="sr-only">العودة إلى أعلى الصفحة</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path
          d="M12 19V5m0 0-6 6m6-6 6 6"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <script>
      document.onkeydown = function (e) {
        if (e.keyCode == 123) {
          return false;
        }
        if (e.ctrlKey && e.shiftKey && e.keyCode == "I".charCodeAt(0)) {
          return false;
        }
        if (e.ctrlKey && e.shiftKey && e.keyCode == "J".charCodeAt(0)) {
          return false;
        }
        if (e.ctrlKey && e.keyCode == "U".charCodeAt(0)) {
          return false;
        }
      };
    </script>
  </body>
</html>
