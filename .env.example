# Copy to .env and fill in real values. Never commit .env.
#
# MongoDB connection string, including the database name.
# Example: mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/the-legend
DATABASE_PATH=

# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SecretPassword=

# Secret used to sign express-session cookies. Generate the same way.
SESSION_SECRET=

# Port the legacy EJS app listens on. Defaults to 5000.
PORT=5000

# Port the new TypeScript API listens on. Defaults to 4000.
# Must differ from PORT so both can run side by side during the migration.
API_PORT=4000

# Origin of the React app, used for CORS. Defaults to the Vite dev server.
WEB_ORIGIN=http://localhost:5173

# Set to "production" when deployed. Enables secure cookies.
NODE_ENV=development
